          }
        },
        "frontmatter": {
          "author": "Tencent Healthcare Omics",
          "description_en": "Use Omics sandboxes to prepare inputs, run analyses, transfer files, verify outputs and manage the authorized instance lifecycle.",
          "description_zh": "使用组学沙箱准备输入、执行分析、传输文件并核验结果，按授权管理实例生命周期。",
          "version": "1.0.3"
        },
        "id": "omics-sandbox-skill",
        "path": "vendor/OmicsSkill/skills/omics-sandbox-skill",
        "repository": "git@git.woa.com:genomics/ai/OmicsSkill.git",
        "source_header": "---\nname: omics-sandbox-skill\ndescription: 通过 Omics CLI 的 Agent Sandbox 执行生命科学脚本、数据探索、统计分析、绘图和结果核验，完成文件上传、沙箱执行及产物下载。适用于需要云端临时分析环境的任务；已有 Jupyter 实例或 ipynb 操作使用 Notebook 技能。\n---\n"
      },
