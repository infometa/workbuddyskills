        "frontmatter": {
          "author": "Tencent Healthcare Omics",
          "description_en": "Use the Omics CLI to manage Lambda applications, environments and storage capacity, inspect and submit workflows, track runs and verify outputs.",
          "description_zh": "通过 Omics CLI 管理 Lambda 应用、环境与容量，查询和提交工作流，跟踪运行并核验结果。",
          "version": "1.1.3"
        },
        "id": "omics-task-skill",
        "path": "vendor/OmicsSkill/skills/omics-task-skill",
        "repository": "git@git.woa.com:genomics/ai/OmicsSkill.git",
        "source_header": "---\nname: omics-task-skill\ndescription: \"通过 Omics CLI 提交和核验 WDL/Nextflow/Lambda 任务，管理 Lambda 应用定义及托管环境，查询环境盘容量；支持已有项目或团队智能体项目，以及单任务和多步骤 Lambda 输入覆盖。\"\n---\n"
      },
      {
        "commit": "a6ad471a2fa893561463b6e837b8b08a33f960a9",
        "dirty": false,
        "files": {
          "SKILL.md": {
            "bytes": 6067,
            "executable": false,
            "sha256": "2df4784d08308df68b413d68260ba6a0df17df0cc89c66b95e380e3ecb0b72fc"
          },
          "references/analysis-and-verification.md": {
