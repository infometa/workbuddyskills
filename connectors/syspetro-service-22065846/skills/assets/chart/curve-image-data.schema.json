{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:syspetro:propdb:curve-image-data:1.0",
  "title": "PROPDB curve-image-data v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templateVersion", "image", "conditions", "adjustables", "panels"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "templateVersion": {"const": "propdb-curve-image-v1.0"},
    "image": {"$ref": "#/$defs/image"},
    "conditions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/condition"}},
    "adjustables": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "limitations": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "panels": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/panel"}}
  },
  "$defs": {
    "scalar": {"type": ["string", "number", "integer", "boolean", "null"]},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["groupKind", "title", "generatedAt", "objectLabel", "scopeLabel", "unitSet", "dataStatus"],
      "properties": {
        "groupKind": {"enum": ["single-curve", "coupled-curve-group"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "subtitle": {"type": "string", "maxLength": 160},
        "generatedAt": {"type": "string", "minLength": 1, "maxLength": 40},
        "objectLabel": {"type": "string", "minLength": 1, "maxLength": 120},
        "scopeLabel": {"type": "string", "minLength": 1, "maxLength": 160},
        "unitSet": {"enum": ["SI", "MET", "ENG"]},
        "dataStatus": {"enum": ["complete", "partial"]}
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "value", "source"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 36},
        "value": {"$ref": "#/$defs/scalar"},
        "unit": {"type": "string", "maxLength": 20},
        "source": {"enum": ["user-input", "automatic-default"]}
      }
    },
    "series": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "values"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 56},
        "values": {"type": "array", "minItems": 2, "maxItems": 200, "items": {"type": ["number", "null"]}}
      }
    },
    "marker": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "label"],
      "properties": {
        "x": {"type": "number"},
        "label": {"type": "string", "minLength": 1, "maxLength": 48},
        "tone": {"enum": ["brand", "teal", "warning", "critical"]}
      }
    },
    "panel": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "xValues", "xLabel", "xUnit", "yLabel", "yUnit", "series"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 60},
        "caption": {"type": "string", "maxLength": 160},
        "xValues": {"type": "array", "minItems": 2, "maxItems": 200, "items": {"type": "number"}},
        "xLabel": {"type": "string", "minLength": 1, "maxLength": 32},
        "xUnit": {"type": "string", "maxLength": 20},
        "yLabel": {"type": "string", "minLength": 1, "maxLength": 32},
        "yUnit": {"type": "string", "maxLength": 20},
        "series": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/series"}},
        "markers": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/marker"}}
      }
    }
  }
}
