{
    "auth": {
        "darwin": "npx -y @infimind-next/ai-hive-mcp@latest auth",
        "linux": "npx -y @infimind-next/ai-hive-mcp@latest auth",
        "win32": "npx -y @infimind-next/ai-hive-mcp@latest auth"
    },
    "unAuth": {
        "darwin": "npx -y @infimind-next/ai-hive-mcp@latest logout",
        "linux": "npx -y @infimind-next/ai-hive-mcp@latest logout",
        "win32": "npx -y @infimind-next/ai-hive-mcp@latest logout"
    },
    "status": {
        "darwin": "npx -y @infimind-next/ai-hive-mcp@latest status",
        "linux": "npx -y @infimind-next/ai-hive-mcp@latest status",
        "win32": "npx -y @infimind-next/ai-hive-mcp@latest status"
    },
    "statusMatch": "Authenticated",
    "authUrlDomain": "ai-hive.iclip.cn",
    "authWaitForExit": true,
    "runtime": {
        "type": "node",
        "version": ">=20.19.0"
    }
}