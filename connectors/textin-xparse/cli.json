{
  "init": {
    "darwin": "curl -fsSL https://dllf.intsig.net/download/2026/Solution/xparse-cli/install.sh | sh && \"$HOME/.local/bin/xparse-cli\" --profile workbuddy config set base_url https://api.textin.com",
    "linux": "curl -fsSL https://dllf.intsig.net/download/2026/Solution/xparse-cli/install.sh | sh && \"$HOME/.local/bin/xparse-cli\" --profile workbuddy config set base_url https://api.textin.com",
    "win32": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"irm https://dllf.intsig.net/download/2026/Solution/xparse-cli/install.ps1 | iex; & \\\"$env:USERPROFILE\\.xparse-cli\\bin\\xparse-cli.exe\\\" --profile workbuddy config set base_url https://api.textin.com\""
  },
  "auth": {
    "darwin": "\"$HOME/.local/bin/xparse-cli\" --profile workbuddy auth device --open-browser=always --output=jsonl",
    "linux": "\"$HOME/.local/bin/xparse-cli\" --profile workbuddy auth device --open-browser=always --output=jsonl",
    "win32": "\"%USERPROFILE%\\.xparse-cli\\bin\\xparse-cli.exe\" --profile workbuddy auth device --open-browser=always --output=jsonl"
  },
  "unAuth": {
    "darwin": "\"$HOME/.local/bin/xparse-cli\" --profile workbuddy auth logout --method oauth",
    "linux": "\"$HOME/.local/bin/xparse-cli\" --profile workbuddy auth logout --method oauth",
    "win32": "\"%USERPROFILE%\\.xparse-cli\\bin\\xparse-cli.exe\" --profile workbuddy auth logout --method oauth"
  },
  "status": {
    "darwin": "\"$HOME/.local/bin/xparse-cli\" --profile workbuddy auth status --output=json",
    "linux": "\"$HOME/.local/bin/xparse-cli\" --profile workbuddy auth status --output=json",
    "win32": "\"%USERPROFILE%\\.xparse-cli\\bin\\xparse-cli.exe\" --profile workbuddy auth status --output=json"
  },
  "statusMatchJson": {
    "logged_in": "true",
    "method": "oauth"
  },
  "authUrlDomain": "api.textin.com",
  "env": {
    "XPARSE_OAUTH_CLIENT_ID": "cli_textin_xparse_workbuddy",
    "XPARSE_BASE_URL": "https://api.textin.com"
  },
  "versionCheck": {
    "command": {
      "darwin": "\"$HOME/.local/bin/xparse-cli\" version",
      "linux": "\"$HOME/.local/bin/xparse-cli\" version",
      "win32": "\"%USERPROFILE%\\.xparse-cli\\bin\\xparse-cli.exe\" version"
    },
    "minVersion": "2.1.0",
    "versionPattern": "xparse-cli version v?(\\d+\\.\\d+\\.\\d+)"
  },
  "authSuppressBrowser": true,
  "authDeviceFlow": {
    "uriPattern": "\"verification_uri_complete\"\\s*:\\s*\"(https?://[^\"]+)\"",
    "codePattern": "\"user_code\"\\s*:\\s*\"([A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4})\"",
    "defaultExpiresInSeconds": 240,
    "codeEmbeddedInUri": true
  }
}
