{
  "runtime": {
    "type": "node",
    "version": ">=18"
  },
  "init": {
    "darwin": "npm install --global --registry=https://registry.npmmirror.com xparse-cli@latest && xparse-cli --profile workbuddy config set base_url https://api.textin.com",
    "linux": "npm install --global --registry=https://registry.npmmirror.com xparse-cli@latest && xparse-cli --profile workbuddy config set base_url https://api.textin.com",
    "win32": "npm.cmd install --global --registry=https://registry.npmmirror.com xparse-cli@latest && xparse-cli.cmd --profile workbuddy config set base_url https://api.textin.com"
  },
  "auth": {
    "darwin": "xparse-cli --profile workbuddy auth device --open-browser=always --output=jsonl",
    "linux": "xparse-cli --profile workbuddy auth device --open-browser=always --output=jsonl",
    "win32": "xparse-cli.cmd --profile workbuddy auth device --open-browser=always --output=jsonl"
  },
  "unAuth": {
    "darwin": "xparse-cli --profile workbuddy auth logout --method oauth",
    "linux": "xparse-cli --profile workbuddy auth logout --method oauth",
    "win32": "xparse-cli.cmd --profile workbuddy auth logout --method oauth"
  },
  "status": {
    "darwin": "xparse-cli --profile workbuddy auth status --output=json",
    "linux": "xparse-cli --profile workbuddy auth status --output=json",
    "win32": "xparse-cli.cmd --profile workbuddy auth status --output=json"
  },
  "statusMatchJson": {
    "logged_in": "true",
    "method": "oauth"
  },
  "authUrlDomain": "api.textin.com",
  "env": {
    "XPARSE_OAUTH_CLIENT_ID": "cli_textin_xparse_workbuddy",
    "XPARSE_BASE_URL": "https://api.textin.com"
  },
  "versionCheck": {
    "command": {
      "darwin": "xparse-cli version",
      "linux": "xparse-cli version",
      "win32": "xparse-cli.cmd version"
    },
    "minVersion": "2.5.0",
    "versionPattern": "xparse-cli version v?(\\d+\\.\\d+\\.\\d+)"
  },
  "authSuppressBrowser": true,
  "authDeviceFlow": {
    "uriPattern": "\"verification_uri_complete\"\\s*:\\s*\"(https?://[^\"]+)\"",
    "codePattern": "\"user_code\"\\s*:\\s*\"([A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4})\"",
    "defaultExpiresInSeconds": 240,
    "codeEmbeddedInUri": true
  }
}
