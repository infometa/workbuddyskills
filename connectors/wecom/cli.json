{
    "runtime": {
        "type": "node",
        "version": ">=18"
    },
    "init": {
        "darwin": "npm install -g @wecom/cli",
        "linux": "npm install -g @wecom/cli",
        "win32": "npm install -g @wecom/cli"
    },
    "versionCheck": {
        "command": {
            "darwin": "wecom-cli --version",
            "linux": "wecom-cli --version",
            "win32": "wecom-cli.cmd --version"
        },
        "minVersion": "1.3.4"
    },
    "auth": {
        "darwin": "wecom-cli auth init --noninteractive --no-browser",
        "linux": "wecom-cli auth init --noninteractive --no-browser",
        "win32": "wecom-cli.cmd auth init --noninteractive --no-browser"
    },
    "unAuth": {
        "darwin": "rm -rf \"$HOME/.config/wecom\"",
        "linux": "rm -rf \"$HOME/.config/wecom\"",
        "win32": "rmdir /s /q \"%USERPROFILE%\\.config\\wecom\""
    },
    "status": {
        "darwin": "wecom-cli auth show",
        "linux": "wecom-cli auth show",
        "win32": "wecom-cli.cmd auth show"
    },
    "statusMatch": "\\bauthorized\\b",
    "authUrlDomain": "work.weixin.qq.com",
    "authWaitForExit": true,
    "authQrModal": false
}
