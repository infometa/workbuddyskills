{
  "runtime": {
    "type": "node",
    "version": ">=18"
  },
  "init": {
    "darwin": "bash \"$SL_CONNECTOR_HOME/install.sh\"",
    "linux": "bash \"$SL_CONNECTOR_HOME/install.sh\"",
    "win32": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%SL_CONNECTOR_HOME%\\install.ps1\""
  },
  "auth": {
    "darwin": "bash \"$SL_CONNECTOR_HOME/launch.sh\" auth",
    "linux": "bash \"$SL_CONNECTOR_HOME/launch.sh\" auth",
    "win32": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%SL_CONNECTOR_HOME%\\launch.ps1\" -Action auth"
  },
  "unAuth": {
    "darwin": "bash \"$SL_CONNECTOR_HOME/launch.sh\" unauth",
    "linux": "bash \"$SL_CONNECTOR_HOME/launch.sh\" unauth",
    "win32": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%SL_CONNECTOR_HOME%\\launch.ps1\" -Action unauth"
  },
  "status": {
    "darwin": "bash \"$SL_CONNECTOR_HOME/launch.sh\" status",
    "linux": "bash \"$SL_CONNECTOR_HOME/launch.sh\" status",
    "win32": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%SL_CONNECTOR_HOME%\\launch.ps1\" -Action status"
  },
  "statusMatch": "\"authenticated\"\\s*:\\s*true",
  "authWaitForExit": true,
  "authUrlDomain": "sly.tcsl.com.cn",
  "env": {
    "SL_CLI_HOME": "$HOME/.slclaw",
    "SL_CONNECTOR_HOME": "$HOME/.workbuddy/connectors-marketplace/connectors/shanlong-claw"
  },
  "versionCheck": {
    "command": {
      "darwin": "bash \"$SL_CONNECTOR_HOME/launch.sh\" version",
      "linux": "bash \"$SL_CONNECTOR_HOME/launch.sh\" version",
      "win32": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%SL_CONNECTOR_HOME%\\launch.ps1\" -Action version"
    },
    "minVersion": "1.0.168"
  }
}
