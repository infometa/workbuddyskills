# ═══════════════════════════════════════════════════════
# 商龙 CLI 连接器配置 (正式环境)
# ═══════════════════════════════════════════════════════

SL_ENV=prod

# ─── 商龙云认证（填入 API Key 即可使用）───
SL_SLY_BASEURL=https://sly.tcsl.com.cn
SL_API_KEY=

# ─── AI 中间层 ───
SL_AI_HOST=https://aia.tcsl.com.cn

# ─── 网关 ───
SL_GATEWAY_HOST=https://aia.tcsl.com.cn/aiproxy
SL_CY7_VIA_GATEWAY=true
SL_CRM_VIA_GATEWAY=true
SL_SCM_VIA_GATEWAY=true

# ─── 直连地址 ───
SL_CY7_API_BASE_URL=https://cyfast.tcsl.com.cn/fast
SL_CRM_API_BASE_URL=https://scrm.wuuxiang.com
SL_SCM_API_BASE_URL=https://tcsl.engine.fxscm.net
SL_REPORT_API_BASE_URL=https://cy.wuuxiang.com/cy7reportcenter/

# ─── StarRocks 数据仓库 ───
MCP_STARROCKS_URL=https://dmp-mcp.tcsl.com.cn/mcp/workbuddy/
SL_DC_MCP_ACCESS_ID=
