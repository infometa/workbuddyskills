{
  "runtime": {
    "type": "node",
    "version": ">=22"
  },
  "init": {
    "darwin": "npm install -g @baomihuatop/popcorn-cli@0.3.1",
    "linux": "npm install -g @baomihuatop/popcorn-cli@0.3.1",
    "win32": "npm install -g @baomihuatop/popcorn-cli@0.3.1"
  },
  "auth": {
    "darwin": "popcorn-cli auth login --no-browser --adapter workbuddy",
    "linux": "popcorn-cli auth login --no-browser --adapter workbuddy",
    "win32": "popcorn-cli.cmd auth login --no-browser --adapter workbuddy"
  },
  "status": {
    "darwin": "popcorn-cli auth status --format workbuddy --expected-origin https://baomihua.top",
    "linux": "popcorn-cli auth status --format workbuddy --expected-origin https://baomihua.top",
    "win32": "popcorn-cli.cmd auth status --format workbuddy --expected-origin https://baomihua.top"
  },
  "unAuth": {
    "darwin": "popcorn-cli auth logout",
    "linux": "popcorn-cli auth logout",
    "win32": "popcorn-cli.cmd auth logout"
  },
  "statusMatch": "^Logged in\\r?\\n?$",
  "authUrlDomain": "baomihua.top",
  "authWaitForExit": true,
  "env": {
    "POPCORN_REQUIRED_AUTH_METHOD": "oauth",
    "POPCORN_OAUTH_CLIENT_ID": "popcorn-workbuddy"
  },
  "versionCheck": {
    "command": {
      "darwin": "popcorn-cli --version",
      "linux": "popcorn-cli --version",
      "win32": "popcorn-cli.cmd --version"
    },
    "minVersion": "0.3.1",
    "versionPattern": "^(\\d+\\.\\d+\\.\\d+)\\s*$"
  },
  "npmRegistry": "https://registry.npmjs.org"
}
