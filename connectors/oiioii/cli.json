{
  "runtime": {
    "type": "node",
    "version": ">=20"
  },
  "init": {
    "darwin": "npm install -g @oiioii/cli",
    "linux": "npm install -g @oiioii/cli",
    "win32": "npm install -g @oiioii/cli"
  },
  "auth": {
    "darwin": "oiioii auth login --workbuddy --no-browser",
    "linux": "oiioii auth login --workbuddy --no-browser",
    "win32": "oiioii.cmd auth login --workbuddy --no-browser"
  },
  "authUrlDomain": "oiioii.tv",
  "authWaitForExit": true,
  "statusMatch": "\"authenticated\"\\s*:\\s*true",
  "unAuth": {
    "darwin": "oiioii auth logout",
    "linux": "oiioii auth logout",
    "win32": "oiioii.cmd auth logout"
  },
  "status": {
    "darwin": "oiioii auth status --json",
    "linux": "oiioii auth status --json",
    "win32": "oiioii.cmd auth status --json"
  },
  "versionCheck": {
    "command": {
      "darwin": "oiioii --version",
      "linux": "oiioii --version",
      "win32": "oiioii.cmd --version"
    },
    "minVersion": "0.1.7"
  }
}
