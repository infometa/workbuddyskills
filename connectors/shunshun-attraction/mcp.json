{
  "mcpServers": {
    "shunshun-attraction": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "shunshun-attraction-mcp@1.2.2"
      ],
      "runtime": {
        "type": "node",
        "version": ">=18.0.0"
      },
      "env": {
        "SSLQAPITOKEN": "${SSLQAPITOKEN}"
      },
      "timeout": 30000
    }
  }
}
