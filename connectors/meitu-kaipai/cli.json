{
  "runtime": {
    "type": "node",
    "version": ">=24"
  },
  "init": {
    "darwin": "npm install -g --include=optional meitu-kaipai-cli@latest --registry=https://registry.npmjs.org/",
    "linux": "npm install -g --include=optional meitu-kaipai-cli@latest --registry=https://registry.npmjs.org/",
    "win32": "npm install -g --include=optional meitu-kaipai-cli@latest --registry=https://registry.npmjs.org/"
  },
  "versionCheck": {
    "command": {
      "darwin": "kaipai --version",
      "linux": "kaipai --version",
      "win32": "kaipai.cmd --version"
    },
    "versionPattern": "(\\d+\\.\\d+\\.\\d+)",
    "minVersion": "0.1.12"
  },
  "auth": {
    "darwin": "kaipai auth login --no-open",
    "linux": "kaipai auth login --no-open",
    "win32": "kaipai.cmd auth login --no-open"
  },
  "unAuth": {
    "darwin": "kaipai auth logout",
    "linux": "kaipai auth logout",
    "win32": "kaipai.cmd auth logout"
  },
  "status": {
    "darwin": "kaipai auth status",
    "linux": "kaipai auth status",
    "win32": "kaipai.cmd auth status"
  },
  "statusMatch": "^connected\\s*$",
  "authUrlDomain": "www.kaipai.com",
  "authWaitForExit": true
}
