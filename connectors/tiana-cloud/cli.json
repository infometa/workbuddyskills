{
  "runtime": {
    "type": "node",
    "version": ">=22"
  },
  "init": {
    "darwin": "npm install -g @tianacloud/cli@latest --registry=https://registry.npmjs.org/",
    "linux": "npm install -g @tianacloud/cli@latest --registry=https://registry.npmjs.org/",
    "win32": "npm.cmd install -g @tianacloud/cli@latest --registry=https://registry.npmjs.org/"
  },
  "auth": {
    "darwin": "tiana login --no-open",
    "linux": "tiana login --no-open",
    "win32": "tiana.cmd login --no-open"
  },
  "status": {
    "darwin": "tiana status",
    "linux": "tiana status",
    "win32": "tiana.cmd status"
  },
  "unAuth": {
    "darwin": "tiana logout",
    "linux": "tiana logout",
    "win32": "tiana.cmd logout"
  },
  "statusMatch": "(?:^|\\n)Quota period:",
  "authUrlDomain": "console.tianacloud.com",
  "authWaitForExit": true,
  "env": {
    "TIANA_API_ORIGIN": "https://console.tianacloud.com"
  }
}
