{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "短剧标签数据契约 v1.0",
  "description": "约束 meta.yaml 的结构。机器调度/自动组装/自动化质检均以本契约校验。",
  "type": "object",
  "required": [
    "schema_version", "id", "name_cn", "category", "carrier", "audience",
    "weight", "level", "version", "emotion_core", "nodes", "boundary", "relations", "redlines"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name_cn": { "type": "string", "minLength": 1 },
    "category": { "enum": ["theme", "setting", "background"] },
    "carrier": {
      "description": "适配载体：manga=漫剧, live-action=真人短剧, both=通用",
      "enum": ["manga", "live-action", "both"]
    },
    "audience": { "enum": ["female", "male", "both"] },
    "weight": { "enum": ["high", "medium", "low"] },
    "level": { "enum": ["level-1", "level-2", "level-3"] },
    "severity": { "enum": ["strong", "medium", "weak"] },
    "version": { "type": "string" },
    "related_combo": { "type": "string" },
    "emotion_core": {
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "nodes": {
      "type": "object",
      "required": ["call", "review"],
      "properties": {
        "call": { "type": "string" },
        "review": { "type": "string" }
      }
    },
    "boundary": {
      "description": "核心定义与边界（对应正文第一节）",
      "type": "object",
      "required": ["audience_desc", "bg_desc", "weight", "bottom_line"],
      "properties": {
        "audience_desc": { "type": "string" },
        "bg_desc": { "type": "string" },
        "weight": { "type": "string" },
        "bottom_line": { "type": "array", "items": { "type": "string" } }
      }
    },
    "relations": {
      "description": "标签关系图。程序据此自动组装与冲突检测。",
      "type": "object",
      "properties": {
        "synergy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "effect"],
            "properties": {
              "target": { "type": "string", "description": "协同目标。英文（ASCII）值视为库内标签 id 引用，必须指向真实存在的标签 id（由 build_registry.py 强校验，杜绝指向空气）；中文值视为跨题材/库外概念（如打脸/甜宠/追妻），仅作创作提示，不校验存在性。" },
              "effect_type": { "enum": ["增强型", "裂变型", "对冲型"] },
              "weight": { "enum": ["high", "medium", "low"] },
              "effect": { "type": "string" }
            }
          }
        },
        "mutex": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "reason"],
            "properties": {
              "target": { "type": "string", "description": "互斥目标。约定同 synergy.target：英文=库内 id 引用（校验存在性），中文=跨题材概念（仅提示）。" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "combo_adapt": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["combo", "rule"],
        "properties": {
          "combo": { "type": "string" },
          "rule": { "type": "string" },
          "sub": { "type": "string" }
        }
      }
    },
    "fusion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recipe", "note"],
        "properties": {
          "recipe": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "redlines": {
      "description": "强规则质检项。auto_review 直接消费。",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "severity", "dimension", "test"],
        "properties": {
          "code": { "type": "string", "pattern": "^AP-[A-Z]{2}\\d{2}$" },
          "name": { "type": "string" },
          "severity": { "enum": ["极高", "高", "中"] },
          "dimension": { "enum": ["标签与逻辑", "人物与人设", "结构与节奏", "内容与红线"] },
          "test": { "type": "string" }
        }
      }
    },
    "soft_warnings": {
      "description": "弱提示避坑项，不扣分。",
      "type": "array",
      "items": { "type": "string" }
    },
    "manga": {
      "description": "漫剧载体专属扩展块（可选）。",
      "type": "object",
      "properties": {
        "visual_signature": { "type": "string" },
        "high_affinity": { "type": "boolean" },
        "visual_hooks": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
