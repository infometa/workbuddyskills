{
  "mcpServers": {
    "kuaixiaotong-agent": {
      "type": "streamableHttp",
      "url": "https://wxcomhelper.ajxt.net/api/mcp",
      "headers": {
        "x-tid": "${TID}",
        "x-userid": "${USERID}",
        "x-access-key-id": "${ACCESS_KEY_ID}",
        "x-access-key-secret": "${ACCESS_KEY_SECRET}"
      },
      "timeout": 30000
    }
  }
}
