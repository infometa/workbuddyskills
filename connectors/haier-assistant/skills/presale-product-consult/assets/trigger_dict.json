{
  "_note": "售前咨询触发词与槽位继承词典。参数名映射以 consult_attributes.json 为准（与产品推荐的品类槽位口径一致），意图判定顺序见 consult_intents.json。",

  "value_intent": {
    "_note": "型号-购买建议（性价比）触发词。命中其一 + 存在具体产品型号 → 走场景三性价比输出；只有品类时不走性价比。",
    "words": [
      "值得买吗", "值得买", "值不值", "值不值得", "值得入手吗", "值得入手",
      "性价比", "性价比怎么样", "性价比高吗", "划算吗", "划不划算",
      "推荐吗", "推荐吗这款", "好不好", "怎么样", "香不香", "值吗", "该买吗", "要不要买",
      "有什么卖点", "卖点", "主要卖点", "亮点", "有什么亮点", "优点", "有什么优点",
      "好在哪", "强在哪", "有什么优势", "优势"
    ]
  },

  "attribute_intent": {
    "_note": "参数/价格触发词。命中其一 → 走型号-参数/价格 或 品类-参数/价格；命中的维度词同时映射为 attributeNames。",
    "words": [
      "价格", "多少钱", "什么价", "报价", "售价", "价位",
      "容量", "多大容量", "多少升", "几升", "几匹", "匹数", "洗涤容量", "总容积",
      "能效", "能效等级", "几级能效", "能效比", "省电吗", "费电吗",
      "尺寸", "多大", "多宽", "多高", "多深", "开孔尺寸", "安装尺寸", "机身尺寸",
      "品牌", "什么牌子", "哪个牌子",
      "参数", "参数是什么", "有哪些参数", "配置", "规格", "详细参数", "全部参数",
      "功能", "有什么功能", "支持什么", "带不带", "有没有", "噪音", "颜色"
    ]
  },

  "full_attribute_intent": {
    "_note": "全量参数触发词。命中其一且未指定具体维度 → attributeNames 留空，走场景二全量参数。",
    "words": ["参数", "参数是什么", "有哪些参数", "全部参数", "详细参数", "所有参数", "配置", "规格", "参数表", "介绍一下"]
  },

  "model_pattern": {
    "_note": "产品型号识别提示（非严格正则，最终以下游是否识别为有效型号为准）。型号通常为「字母前缀-字母数字组合」，可含数字、字母、连字符。识别到的候选型号原样传给工具，不改写、不补全、不纠正拼写。",
    "hints": [
      "常见形态：BCD-526WGCTDAGWPU1、BCD-470WGHTD1BGZU1、LW1658GH、XQG100-HLD58A1、KFR-35GW/xxx、JSQ31-16WT5",
      "以品类字母前缀 + 连字符 + 容量/功率数字 + 功能字母后缀为主；也存在无连字符的短型号（如 LW1658GH）",
      "品牌智能体可能直接传入产品型号（示例 BCD-345XXXX），此时优先使用传入值"
    ],
    "guardrails": [
      "不得把品类词、套系名、品牌名当作型号（如「冰箱」「致境」「卡萨帝」不是型号）。",
      "不得为凑出型号而自行编造或从记忆外补充型号。",
      "型号与品类同时存在时只走型号分支，不重复调用品类分支。"
    ]
  },

  "memory_reference": {
    "_note": "上下文指代消解词典。ordinal 从记忆最近一次搜索/推荐结果的型号列表中按序号定位；demonstrative 使用记忆中提取的槽位型号。",
    "ordinal": {
      "1": ["第一款", "第一个", "第一台", "第1款", "首款", "第一"],
      "2": ["第二款", "第二个", "第二台", "第2款", "第二"],
      "3": ["第三款", "第三个", "第三台", "第3款", "第三"],
      "4": ["第四款", "第四个", "第4款", "第四"],
      "5": ["第五款", "第五个", "第5款", "第五"]
    },
    "demonstrative": ["这款", "那款", "这个", "那个", "这台", "那台", "它", "上面那个", "刚才那款", "刚说的那款"]
  },

  "slot_inheritance": {
    "_note": "槽位继承规则（与 SKILL.md 表格一致，供规则匹配直接引用）。",
    "rules": [
      {"case": "当前轮有型号，记忆也有型号，两者一致", "action": "直接使用，无需处理"},
      {"case": "当前轮有型号A，记忆有型号B，A≠B", "action": "覆盖：以当前轮为准"},
      {"case": "当前轮无型号，记忆有型号", "action": "补全：使用记忆中的型号"},
      {"case": "当前轮说第一款/第二个", "action": "定位：从记忆最近搜索结果的型号中按序号定位"},
      {"case": "当前轮说这款/那个", "action": "指代消解：使用记忆提取的槽位型号"}
    ],
    "limits": {
      "model_per_turn": 5,
      "model_in_memory": 5,
      "model_truncate": "同一批数据按进入时间先后顺序取前 5 个",
      "category_per_turn": 1,
      "category_in_memory": 1,
      "category_truncate": "按最近时间排序截断，只保留 1 个"
    }
  },

