{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fbsir.example/schemas/cognitive-asset-manifest.v1.json",
  "title": "FBSir Cognitive Asset Manifest",
  "type": "object",
  "required": ["schema", "catalogVersion", "productVersion", "generatedAt", "seatIds", "phasePolicies", "assets", "evidenceBoundary"],
  "properties": {
    "schema": { "const": "fbsir.cognitive-asset-manifest/v1" },
    "catalogVersion": { "$ref": "#/$defs/version" },
    "productVersion": { "const": "26.7.20" },
    "generatedAt": { "type": "string", "format": "date" },
    "seatIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "phasePolicies": {
      "type": "object",
      "required": ["phase0_intake", "phase1_independent", "phase1_process_support", "phase2_challenge", "phase3_synthesis"],
      "properties": {
        "phase0_intake": { "$ref": "#/$defs/phasePolicy" },
        "phase1_independent": { "$ref": "#/$defs/phasePolicy" },
        "phase1_process_support": { "$ref": "#/$defs/phasePolicy" },
        "phase2_challenge": { "$ref": "#/$defs/phasePolicy" },
        "phase3_synthesis": { "$ref": "#/$defs/phasePolicy" }
      },
      "unevaluatedProperties": false
    },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } },
    "evidenceBoundary": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "phase": { "enum": ["phase0_intake", "phase1_independent", "phase1_process_support", "phase2_challenge", "phase3_synthesis"] },
    "kind": { "enum": ["method", "checklist", "counterexample", "case"] },
    "phasePolicy": {
      "type": "object",
      "required": ["allowedKinds", "requiredKinds", "maxItems", "maxChars"],
      "properties": {
        "allowedKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/kind" } },
        "requiredKinds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/kind" } },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maxChars": { "type": "integer", "minimum": 200, "maximum": 12000 }
      },
      "unevaluatedProperties": false
    },
    "applicability": {
      "type": "object",
      "required": ["jurisdictions", "industries", "companyStages", "decisionTypes", "requires", "notFor"],
      "properties": {
        "jurisdictions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "industries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "companyStages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "decisionTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "notFor": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      },
      "unevaluatedProperties": false
    },
    "freshness": {
      "type": "object",
      "required": ["validityClass", "asOf", "reviewBy", "stalePolicy"],
      "properties": {
        "validityClass": { "enum": ["structural_method", "internal_curated", "historical_case", "periodic_benchmark", "live_fact", "legal_authority"] },
        "asOf": { "type": "string", "format": "date" },
        "reviewBy": { "type": "string", "format": "date" },
        "stalePolicy": { "enum": ["exclude", "require_review", "require_live_verification"] }
      },
      "unevaluatedProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "assetId", "kind", "version", "status", "ownerSeatIds", "phaseAllowlist", "sceneIds",
        "isDefaultForSeat", "priority", "triggers", "exclusions", "applicability", "freshness",
        "sourceRefs", "contentPath", "contentSha256", "contentChars", "requiredHeadings",
        "productionEligible", "supersedes", "changeSummary"
      ],
      "properties": {
        "assetId": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/kind" },
        "version": { "$ref": "#/$defs/version" },
        "status": { "enum": ["active", "deprecated", "withdrawn"] },
        "ownerSeatIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "phaseAllowlist": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/phase" } },
        "sceneIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(\\*|[a-z][a-z0-9_]{0,63})$" } },
        "isDefaultForSeat": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "triggers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "exclusions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "applicability": { "$ref": "#/$defs/applicability" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^src:[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" } },
        "contentPath": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.md$" },
        "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contentChars": { "type": "integer", "minimum": 1, "maximum": 12000 },
        "requiredHeadings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "productionEligible": { "type": "boolean" },
        "supersedes": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "changeSummary": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "unevaluatedProperties": false
    },
    "methodAsset": { "allOf": [{ "$ref": "#/$defs/asset" }, { "properties": { "kind": { "const": "method" } } }] },
    "checklistAsset": { "allOf": [{ "$ref": "#/$defs/asset" }, { "properties": { "kind": { "const": "checklist" } } }] },
    "counterexampleAsset": { "allOf": [{ "$ref": "#/$defs/asset" }, { "properties": { "kind": { "const": "counterexample" } } }] },
    "caseAsset": { "allOf": [{ "$ref": "#/$defs/asset" }, { "properties": { "kind": { "const": "case" } } }] }
  }
}
