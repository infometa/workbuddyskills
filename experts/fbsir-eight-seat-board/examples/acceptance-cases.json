{
  "schema": "fbsir-independent-review-acceptance/v1",
  "productVersion": "26.8.10",
  "expectedAgentSemantics": {
    "meaning": "routing_candidate_only_not_dispatch_authorization",
    "appliesToLegacyCaseIds": ["secretary-basic-process-support"],
    "dispatchAllowedByExpectedAgentAlone": false,
    "requiredDispatchPreconditions": ["explicit_user_confirmation", "frozen_exact_plan", "selected_process_support", "secretary_selected"]
  },
  "cases": [
    {
      "id": "quick-single-domain-contract",
      "input": "请帮我看这份采购合同里最危险的三处。",
      "expectedMode": "quick_review",
      "expectedSeats": ["legal-partner"],
      "mustProduce": ["decision_start_card", "quick_review_card"],
      "mustNotProduce": ["simulated_multi_seat_opinions"]
    },
    {
      "id": "standard-growth-channel",
      "input": "经销商增长停了，要不要转直营并同步做线上？",
      "expectedMode": "standard_review",
      "expectedSeatRange": [2, 3],
      "expectedSeatCandidates": ["growth-partner", "operations-partner", "digital-partner", "capital-partner"]
    },
    {
      "id": "decision-intake-growth-stagnation-single-turn-terminal",
      "input": "公司增长停滞了，请先形成紧凑决策起手卡，比较深挖主业、变革渠道和可逆的小试第二曲线，最多问 2 个决定性问题；仍只显示“按建议开始独立审议”“补充关键事实”“切换审议模式”，我明确确认前不要写案卷或建团。",
      "expectedRoute": "decision_intake",
      "expectedCompletion": "single_completed_response",
      "preflightSequence": ["entry", "material-card", "proposal"],
      "preflightVisibility": "tool_calls_and_results_only_no_assistant_messages",
      "preflightReceiptVisibility": "internal_only_never_in_terminal_card",
      "terminalResponseShape": "canonical_card_only_no_preflight_receipt_status_or_trailing_text",
      "allowedAssistantCompletedBeforeTerminalDelivery": 0,
      "silentPreflightFailurePolicy": "skip_preflight_and_emit_complete_safe_card_as_only_assistant_message",
      "requiredDecisionStartCardSections": [
        "decision_definition",
        "options_and_non_goals",
        "known_assumptions_and_minimum_materials",
        "review_mode_and_minimum_seats",
        "reversible_action"
      ],
      "requiredMaterialCardSections": [
        "material_state",
        "received_materials_and_versions",
        "missing_and_impact",
        "pending_verification",
        "conclusion_boundary",
        "material_next_action"
      ],
      "maxDecisionChangingQuestions": 2,
      "questionPunctuationBudget": {
        "maxTotal": 2,
        "maxPerNumberedQuestion": 1,
        "lineFormat": "single_line_decimal_1_then_2",
        "overflowPolicy": "fold_remaining_gap_into_minimum_materials"
      },
      "requiredActions": {
        "primary": "按建议开始独立审议",
        "secondary": ["补充关键事实", "切换审议模式"]
      },
      "entryFailurePolicy": {
        "repairAttempts": 1,
        "fallback": "safe_without_normalized_route_or_deterministic_receipt_claims"
      },
      "materialCardFailurePolicy": {
        "maxInvocations": 1,
        "repairAttempts": 0,
        "firstNonOkReceipt": "terminal_absorbing",
        "shortCircuitRemainingPreflights": true,
        "laterSuccessMayNotOverride": true,
        "fallback": "safe_without_material_state_claims"
      },
      "proposalFailurePolicy": {
        "reorderRepairAttempts": 1,
        "fallback": "safe_without_validated_seat_claims"
      },
      "fallbackOnScriptFailure": "safe_decision_start_card_without_deterministic_receipt_claims",
      "mustProduce": [
        "five_section_decision_start_card",
        "material_sufficiency_card",
        "exactly_one_primary_action_two_secondary_branches",
        "same_turn_terminal_delivery"
      ],
      "mustNotProduce": [
        "directory_exploration_placeholder",
        "user_visible_plan_before_preflight",
        "pre_tool_preamble_completed",
        "between_tool_progress_completed",
        "post_tool_transition_completed",
        "preflight_receipt_status_in_terminal_card",
        "material_card_retry_after_first_failure",
        "later_material_success_overrides_first_failure",
        "aggregate_preflight_success_claim_after_any_failure",
        "more_than_two_interrogative_marks_or_noncanonical_question_line",
        "noncanonical_action_labels_or_trailing_text",
        "corrective_followup_required",
        "script_failure_as_first_value_blocker",
        "case_workspace",
        "team_creation"
      ]
    },
    {
      "id": "standard-merger",
      "input": "准备收购一家上游企业，价格和协同是否值得？",
      "expectedMode": "standard_review",
