{
  "name": "fbsir-eight-seat-board",
  "version": "26.8.19",
  "description": "FBSir Independent Review Board is a configurable AI decision-review team for real-economy leaders, producing evidence-aware, dissent-preserving and action-oriented review memos.",
  "author": {
    "name": "福帮手",
    "email": "unique@u3w.com"
  },
  "brand": {
    "en": "FBSir",
    "zh": "福帮手"
  },
  "governanceModel": {
    "schema": "fbsir-independent-review-board/v2",
    "inspiration": "independent-director-form",
    "notLegalBoard": true,
    "noFiduciaryAuthority": true,
    "aiRolesOnly": true,
    "noEntityInterests": true,
    "decisionOwner": "user"
  },
  "productIdentity": {
    "productClass": "ai-expert-team",
    "canonicalName": {
      "en": "FBSir Independent Review Board",
      "zh": "独董会"
    },
    "stablePackageId": "fbsir-eight-seat-board",
    "relationshipToListedSuperPartner": "independent-product",
    "notAliasOf": "fbsir-super-partner-group",
    "evidenceNamespace": "fbsir-eight-seat-board"
  },
  "experienceModel": {
    "principle": "configurable-role-pool-case-specific-panel",
    "defaultMode": "standard_review",
    "teamCreationRequiresExplicitConfirmation": true,
    "preConfirmationWorkspaceWriteAllowed": false,
    "primaryCta": "按建议开始独立审议",
    "secondaryBranches": [
      "补充关键事实",
      "切换审议模式"
    ],
    "questionsMax": 2,
    "questionsPolicy": "decisive_only",
    "modes": [
      "quick_review",
      "standard_review",
      "deep_review"
    ],
    "connectorRequired": false,
    "firstValue": "decision_start_card",
    "rosterPolicy": {
      "countMutable": true,
      "leadCount": 1,
      "supportRoleCount": 1,
      "minimumSpecialistPoolSize": 1,
      "currentMemberSource": "members",
      "professionalSeatFilter": "seatClass is absent or equals professional_review",
      "supportRolesDoNotCountAsProfessionalSeats": true,
      "selectionByMode": {
        "quick_review": "one_relevant_specialist",
        "standard_review": "two_to_three_relevant_specialists_capped_by_available_pool",
        "deep_review": "two_to_three_relevant_specialists_for_deep_review_preparation"
      }
    }
  },
  "entryContract": {
    "schema": "fbsir.entry-contract/v1",
    "routes": [
      {
        "route": "capability_discovery",
        "firstValue": "capability_card",
        "maxQuestions": 0
      },
      {
        "route": "decision_intake",
        "firstValue": "decision_start_card",
        "maxQuestions": 2
      },
      {
        "route": "material_review_intake",
        "firstValue": "decision_start_card_with_material_sufficiency",
        "maxQuestions": 2
      },
      {
        "route": "continue_or_resume",
        "firstValue": "case_resume_card",
        "maxQuestions": 1
      },
      {
        "route": "graceful_redirect",
        "firstValue": "graceful_redirect_card",
        "maxQuestions": 1
      }
    ],
    "actions": [
      {
        "actionId": "confirm_review",
        "role": "primary",
        "labelZh": "按建议开始独立审议"
      },
      {
        "actionId": "add_facts",
        "role": "secondary",
        "labelZh": "补充关键事实"
      },
      {
        "actionId": "change_mode",
        "role": "secondary",
        "labelZh": "切换审议模式"
      },
      {
        "actionId": "resume_case",
        "role": "resume",
        "labelZh": "确认继续案卷"
      }
    ]
  },
