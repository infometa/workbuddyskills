{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkBuddy Skill Dependency Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities", "dependencies", "functional_degradations"],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required", "auth_type", "capabilities", "checks", "setup", "degradation"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "enum": ["mcp", "cli", "api", "account", "local-tool", "runtime", "model", "network", "permission"]
          },
          "required": {
            "type": "boolean"
          },
          "auth_type": {
            "enum": ["none", "browser-login", "token", "api-key", "oauth", "service-account"]
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "required"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": ["cli", "cli_probe", "env", "file", "json_field", "mcp", "mcp_probe", "auth_probe", "python", "url"]
                },
                "required": {
                  "type": "boolean"
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string"
                },
                "min_version": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "server": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "method": {
                  "enum": ["HEAD", "GET"]
                },
                "expected_status": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "setup": {
            "type": "object",
            "additionalProperties": false,
            "required": ["official_home_url", "official_docs_url", "steps", "verify", "security", "verified_at", "applies_to_version"],
            "properties": {
              "official_home_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "official_docs_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "download_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "login_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "credential_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "console_path": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "credential_storage": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "verify": {
                "type": "string",
                "minLength": 1
              },
              "rotate_or_revoke": {
                "type": "string"
              },
              "security": {
                "type": "string",
                "minLength": 1
              },
              "verified_at": {
                "type": "string",
                "format": "date"
              },
              "applies_to_version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "degradation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/degradation"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "auth_type": {
                  "not": {
                    "const": "none"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "setup": {
                  "required": ["login_url", "console_path", "credential_storage", "rotate_or_revoke"]
                },
                "checks": {
                  "contains": {
                    "properties": {
                      "type": {
                        "const": "auth_probe"
                      },
                      "required": {
                        "const": true
                      }
                    },
                    "required": ["type", "required", "target"]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "auth_type": {
                  "enum": ["token", "api-key", "oauth", "service-account"]
                }
              }
            },
            "then": {
              "properties": {
                "setup": {
                  "required": ["credential_url", "scopes"]
                },
                "checks": {
                  "contains": {
                    "properties": {
                      "type": {
                        "const": "auth_probe"
                      },
                      "required": {
                        "const": true
                      }
                    },
                    "required": ["type", "required", "target"]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "mcp"
                }
              }
            },
            "then": {
              "properties": {
                "checks": {
                  "allOf": [
                    {
                      "contains": {
                        "properties": {
                          "type": {
                            "const": "mcp"
                          }
                        },
                        "required": ["type"]
                      }
                    },
                    {
                      "contains": {
                        "properties": {
                          "type": {
                            "const": "mcp_probe"
                          },
                          "required": {
                            "const": true
                          }
                        },
                        "required": ["type", "required", "target"]
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "cli"
                }
              }
            },
            "then": {
              "properties": {
                "checks": {
                  "allOf": [
                    {
                      "contains": {
                        "properties": {
                          "type": {
                            "const": "cli"
                          }
                        },
                        "required": ["type"]
                      }
                    },
                    {
                      "contains": {
                        "properties": {
                          "type": {
                            "const": "cli_probe"
                          },
                          "required": {
                            "const": true
                          }
                        },
                        "required": ["type", "required", "target"]
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "api"
                }
              }
            },
            "then": {
              "properties": {
                "checks": {
                  "contains": {
                    "properties": {
                      "type": {
                        "enum": ["url", "auth_probe"]
                      }
                    },
                    "required": ["type"]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "functional_degradations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/degradation"
      }
    }
  },
  "$defs": {
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "trigger", "fallback", "user_input", "limitations", "evidence_label", "recovery", "stop_condition"],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "user_input": {
          "type": "string"
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "evidence_label": {
          "enum": ["已验证", "部分验证", "推断", "未验证"]
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
