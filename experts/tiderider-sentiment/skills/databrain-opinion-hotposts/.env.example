# 复制为 .env 后填值（生产由服务端环境变量注入，.env 仅本地开发用）
#
# 获取 token：
#   内网: https://databrain.woa.com/v2/user-center/personal-tokens-center
#   外网: https://databrain-global.intlgame.com/v2/user-center/personal-tokens-center
# 注意：填原始值，不要加 'Bearer ' 前缀（脚本会自动拼接）
DATABRAIN_TOKEN=

# 可选：固定 host（仅允许受信任域名：databrain.woa.com / databrain.intlgame.com / databrain-*.intlgame.com）
# 不设置时使用默认 host: databrain-global.intlgame.com
# DATABRAIN_HOST=https://databrain-global.intlgame.com

# 可选：全局请求节流间隔（秒），默认 3.0；调小可加速但更易触发 EdgeOne 限流
# HOTPOSTS_QUERY_INTERVAL=3.0

# ── 投递（publish_digest.py）──────────────────────────────────────────
# AI Gallery 上传使用当前用户的 DATABRAIN_TOKEN，作品归属当前用户账号并保持 visibility=self。
# 如需单独覆盖 Gallery 上传 token，可设置 DATABRAIN_GALLERY_TOKEN；通常不需要。
# DATABRAIN_GALLERY_TOKEN=

# 可选：企业微信机器人 Webhook，多个用 ; 分隔；也可用 --webhook_url 命令行传入。
# WEBHOOK_URLS=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 可选：AI Gallery 作品标签（JSON 数组，1-5 项），默认 [{"id":1}]
# DATABRAIN_GALLERY_TAGS=[{"id":1}]
