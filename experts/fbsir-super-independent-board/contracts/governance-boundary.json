{
  "schemaVersion": "fbsir.super-independent-board.governance-boundary/v1",
  "productId": "fbsir-super-independent-board",
  "packageVersionSource": "../.codebuddy-plugin/plugin.json#/version",
  "decisionOwner": "user",
  "singleAgentOnly": true,
  "statutoryBoardClaimAllowed": false,
  "statutoryIndependentDirectorOpinionAllowed": false,
  "aiAllowedActions": [
    "frame_decision",
    "separate_evidence_and_assumptions",
    "generate_strongest_countercase",
    "compare_options",
    "propose_conditions_and_kill_criteria",
    "draft_decision_artifacts",
    "propose_one_next_action",
    "prepare_human_review_handoff"
  ],
  "humanReservedActions": [
    "final_decision",
    "legal_or_regulatory_approval",
    "tax_or_audit_opinion",
    "board_or_management_approval",
    "external_publication",
    "signature",
    "payment",
    "irreversible_organizational_action"
  ],
  "mandatoryHumanReviewDomains": [
    "legal",
    "regulatory",
    "tax",
    "equity",
    "employment",
    "production_safety",
    "medical",
    "financial_transaction",
    "cross_border_data",
    "major_asset_disposal"
  ]
}
