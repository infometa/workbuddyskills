{
  "_note": "MOM 强制要求的 Key Employment Terms，所有员工均须收到书面 KETs",
  "source": "https://www.mom.gov.sg/employment-practices/contract-of-service/key-employment-terms",
  "required_items": [
    "1. 雇主全名",
    "2. 员工全名",
    "3. 职位、主要职责",
    "4. 入职日期",
    "5. 雇佣期限（固定期限合同）",
    "6. 工作安排（每日工时、每周天数、休息日）",
    "7. 薪资周期",
    "8. 基本工资（含时薪/日薪/计件基础费率）",
    "9. 固定津贴",
    "10. 固定扣款",
    "11. 加班支付周期",
    "12. 加班费率",
    "13. 其他薪资组成（奖金、激励）",
    "14. 假期类型（年假/病假/住院假/产假/育儿假）",
    "15. 其他医疗福利（保险/医疗/牙科）",
    "16. 试用期",
    "17. 通知期",
    "18. 工作地点（可选但强烈建议）"
  ],
