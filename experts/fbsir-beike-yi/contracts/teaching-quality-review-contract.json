{
  "schemaVersion": "beike-yi.teaching-quality-review/v1",
  "purpose": "Routes teaching quality concerns to visible evidence and human review instead of unsupported approval claims.",
  "checkFamilies": [
    "goal_alignment",
    "grade_fit",
    "content_accuracy",
    "misconception",
    "time_feasibility",
    "resource_feasibility",
    "assessment_alignment",
    "student_safety_and_privacy",
    "copyright_and_source"
  ],
  "statuses": [
    "confirmed_issue",
    "suspected_issue",
    "not_found",
    "not_assessed"
  ],
  "requiredFindingFields": [
    "status",
    "location",
    "reason",
    "evidenceOrGap",
    "suggestedRevision",
    "humanReviewRequired"
  ],
  "humanReviewRequiredByDefault": true,
  "forbiddenClaims": [
    "already_compliant",
    "guaranteed_effective",
    "ready_for_direct_classroom_use",
    "student_has_mastered",
    "school_approved",
    "curriculum_standard_certified"
  ]
}
