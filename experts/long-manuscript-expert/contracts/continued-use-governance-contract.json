{
  "schemaVersion": "long_manuscript.continued_use_governance_contract.v1",
  "contractId": "long-manuscript-continued-use-governance",
  "packageVersion": "26.7.18",
  "enforcementTopology": {
    "repositoryValidatorModule": "lib/continued-use-governance.mjs",
    "repositorySupportingModules": ["lib/project-workflow-contract.mjs"],
    "validatorScope": "workspace_root_review_only",
    "validatorIncludedInProductZip": false,
    "schemaIsNotAnExecutableValidator": true,
    "hostExecutionProven": false,
    "crossFieldEqualityEnforcement": "repository_validator_only"
  },
  "fixtureRef": "fixtures/behavior/r8-continued-use-governance-scenarios.json",
  "continuedUseCard": {
    "schemaRef": "schemas/continued-use-card-v1.schema.json",
    "cardType": "long_manuscript_continue_card",
    "deliverySurface": "chat_response",
    "deliveryState": "visible_in_current_response",
    "requiredOutcomeFields": [
      "completedNow",
      "incrementalArtifact",
      "openItems",
      "nextVisibleArtifact",
      "nextActions",
      "resumeCommand",
      "exitOption"
    ],
    "nextActionCount": {"min": 2, "max": 3},
    "openItemsFieldRequired": true,
    "openItemTypes": ["blocker", "unverified", "risk"],
    "openItemStatusByType": {
      "blocker": "blocked",
      "unverified": "pending_verification",
      "risk": "risk_acknowledgement_needed"
    },
    "openItemRequiredFields": ["itemId", "type", "summary", "status", "nextActionId"],
    "resumeScope": "user_copyable_current_response",
    "defaultPersistenceClaim": "not_persisted",
    "persistenceUpgradeRequiresHostReceipt": true,
    "contentOnlyCardCannotAdvanceClosedLoopState": true
  },
  "roleWriteOwnership": {
    "roleCatalogRef": "templates/expert-team-roles.json",
    "singleWriteOwnerPerArtifactRequired": true,
    "reviewerMayReviewWriterArtifact": true,
    "reviewerMayWriteWriterArtifact": false,
    "dualWriterDecision": "block_and_escalate_to_human_merge_owner",
    "silentMutationAllowed": false,
    "mergeOwner": "human_owner",
    "humanFinalApprovalRequired": true,
    "packageFinalApprovalClaimAllowed": false
  },
  "healthyContinuationMeasurement": {
    "measurementDictionaryRef": "templates/measurement-dictionary.json",
    "evidenceClass": "deterministic_contract_fixture",
    "sampleSemantics": "synthetic_fixture_counts_not_production_observations",
    "decisionUse": "quality_guardrail_not_engagement_target",
    "rawIdentifierForbidden": true,
    "naturalTrafficClaimAllowed": false,
    "causalImpactClaimAllowed": false,
    "timeWindowRequired": true,
    "denominatorRequired": true,
    "requiredMetricIds": [
      "incremental_artifact_delivery_rate",
      "recovery_success_rate",
      "duplicate_content_rate",
      "unresolved_fact_item_rate",
      "user_initiated_continue_rate",
      "pressure_free_exit_availability_rate",
      "false_persistence_claim_rate",
      "role_conflict_block_rate"
    ],
    "requiredCompleteGuardrails": [
      "pressure_free_exit_availability_rate",
      "role_conflict_block_rate"
    ],
    "requiredZeroGuardrails": [
      "duplicate_content_rate",
      "false_persistence_claim_rate"
    ]
  },
  "cannotProve": [
    "host execution of a continuation action",
    "cross-session persistence or recovery",
    "same-binding continued-use receipt",
    "natural traffic conversion or causal uplift",
    "human final approval or external delivery"
  ]
}
