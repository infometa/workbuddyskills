{
  "schemaVersion": "long_manuscript.claim_evidence_coverage_contract.v1",
  "contractId": "long-manuscript-claim-evidence-coverage",
  "nativeOnly": true,
  "runtimeDependencyRequired": false,
  "enforcementTopology": {
    "repositoryValidatorModule": "lib/claim-evidence-coverage.mjs",
    "repositorySupportingModules": ["lib/manuscript-quality-evidence-alignment.mjs"],
    "validatorScope": "workspace_root_review_only",
    "validatorIncludedInProductZip": false,
    "schemaIsNotAnExecutableValidator": true,
    "hostExecutionProven": false,
    "crossFieldEqualityEnforcement": "repository_validator_only"
  },
  "claimEvidenceMapSchemaRef": "schemas/claim-evidence-map-v1.schema.json",
  "qualityGateContractRef": "contracts/manuscript-quality-gate-contract.json",
  "claimToSourceAndAnchorTraceabilityRequired": true,
  "criticalClaimFieldRequired": true,
  "criticalClaimsMustBeReferencedByFactsGate": true,
  "criticalClaimsBlockPassUnlessSupportedAndFreshnessNotApplicable": true,
  "revisionArtifactBindingRequired": true,
  "knownAnchorRequired": true,
  "sourceAssetOriginUniquenessRequired": true,
  "publishableClaimPromotionForbidden": true,
  "externalWriteForbidden": true,
  "cannotProve": [
    "fact truth",
    "source license",
    "currentness",
    "human approval"
  ]
}
