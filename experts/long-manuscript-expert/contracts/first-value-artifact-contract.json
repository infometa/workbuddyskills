{
  "schemaVersion": "long_manuscript.first_value_artifact_contract.v1",
  "contractId": "long-manuscript-first-value-artifact",
  "nativeOnly": true,
  "runtimeDependencyRequired": false,
  "enforcementTopology": {
    "repositoryValidatorModule": "lib/first-value-artifact-contract.mjs",
    "validatorScope": "workspace_root_review_only",
    "validatorIncludedInProductZip": false,
    "schemaIsNotAnExecutableValidator": true,
    "hostExecutionProven": false,
    "crossFieldEqualityEnforcement": "repository_validator_only"
  },
  "artifactSchemaRef": "schemas/first-value-artifact-v1.schema.json",
  "policyRef": "templates/first-value-artifact-policy.json",
  "defaultDeliverySurface": "chat_response",
  "defaultWriteIntent": "unrequested",
  "explicitWriteIntentRequired": true,
  "actualPersistenceOutsideR1": true,
  "requiredVisibleBlockKinds": [
    "current_judgement",
    "scene_template",
    "chapter_route",
    "draft_text",
    "risk_boundary",
    "progress_card",
    "next_actions"
  ],
  "requiredVisibleBlockEditability": {
    "current_judgement": false,
    "scene_template": true,
    "chapter_route": true,
    "draft_text": true,
    "risk_boundary": false,
    "progress_card": false,
    "next_actions": true
  },
  "diagnosisCardSchemaVersion": "long_manuscript.diagnosis_card.v1",
  "diagnosisCardTemplateRef": "templates/diagnosis-card.json",
  "requiredContinuationScope": "user_copyable_current_response",
  "forbiddenClaims": ["auto_saved_file", "download_ready", "host_persistence_observed", "cross_session_recovery_observed", "external_delivery_observed"],
  "safeFilterRecovery": {
    "schemaVersion": "long_manuscript.safe_filter_recovery.v1",
    "policyOverrideForbidden": true,
    "blockedContentRetentionForbidden": true,
    "externalWriteForbidden": true
  }
}
