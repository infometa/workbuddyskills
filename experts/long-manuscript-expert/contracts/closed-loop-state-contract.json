{
  "schemaVersion": "long_manuscript.closed_loop_state_contract.v1",
  "contractId": "long-manuscript-canonical-closed-loop-state",
  "packageVersion": "26.7.18",
  "enforcementTopology": {
    "repositoryValidatorModule": "lib/closed-loop-state.mjs",
    "repositorySupportingModules": ["lib/lebao-consent.mjs"],
    "validatorScope": "workspace_root_review_only",
    "validatorIncludedInProductZip": false,
    "schemaIsNotAnExecutableValidator": true,
    "hostExecutionProven": false,
    "crossFieldEqualityEnforcement": "repository_validator_only"
  },
  "recordSchemaRef": "schemas/closed-loop-state-record-v1.schema.json",
  "fixtureRef": "fixtures/behavior/r8-closed-loop-state-scenarios.json",
  "canonicalMilestoneStates": [
    "first_value_completed",
    "continued_use_ready",
    "continued_use_completed",
    "lebao_claim_pending",
    "host_receipt_pending",
    "closed_loop_verified"
  ],
  "auxiliaryObservationStates": [
    "whoami_observed",
    "scene_pack_observed"
  ],
  "transitionPolicy": {
    "milestoneHistoryMustEqualCanonicalPrefix": true,
    "auxiliaryObservationAdvancesMilestone": false,
    "duplicateMilestoneAllowed": false,
    "skipAllowed": false,
    "contentOnlyAnswerCanAdvancePastContinuedUseReady": false,
    "legacyAttributionStatesHaveTransitionAuthority": false
  },
  "packageFixturePolicy": {
    "maxState": "lebao_claim_pending",
    "allowedReceiptStatuses": [
      "missing",
      "structurally_valid_external_fixture"
    ],
    "hostReceiptPendingAllowed": false,
    "closedLoopVerifiedAllowed": false,
    "hostExecutionProven": false,
    "listingVerified": false,
    "sameBindingRuntimeVerified": false,
    "serviceVerifierObserved": false,
    "closedLoopVerifiedClaimed": false,
    "productCreditClaimed": false
  },
  "validatorDecisionPolicy": {
    "packageStateThrough": "lebao_claim_pending",
    "hostReceiptPendingDecision": "external_verification_required",
    "closedLoopVerifiedDecision": "external_verification_required",
    "externalGateStatus": "blocked_external",
    "structurallyCompleteExternalReceiptsAreNotAuthenticityProof": true,
    "schemaValidationOrRepositoryValidationIsNotReceiptAuthenticity": true,
    "packageSelfPromotionAllowed": false
  },
  "stateEvidenceRequirements": {
    "first_value_completed": ["visible_first_value_artifact"],
    "continued_use_ready": ["continued_use_card_contract_valid"],
    "continued_use_completed": [
      "external_continued_use_receipt_shape",
      "same_binding_external_receipt_shape"
    ],
    "lebao_claim_pending": [
      "valid_explicit_claim_consent",
      "consent_subject_binding_matches_state_record"
    ],
    "host_receipt_pending": [
      "external_scope_only",
      "verified_listing_receipt",
      "verified_service_verifier_receipt",
      "verified_same_binding_receipt"
    ],
    "closed_loop_verified": [
      "verified_listing_receipt",
      "verified_host_ack_receipt",
      "verified_same_binding_receipt",
      "verified_continued_use_receipt",
      "verified_service_verifier_receipt",
      "all_receipts_bound_to_current_package_host_and_subject"
    ]
  },
  "receiptStatuses": [
    "missing",
    "structurally_valid_external_fixture",
    "verified_external"
  ],
  "receiptSourceByProof": {
    "continuedUse": "authorized_host",
    "listing": "service_registry",
    "hostAck": "authorized_host",
    "sameBinding": "authorized_service",
    "serviceVerifier": "authorized_service"
  },
  "closedLoopComposite": {
    "requiredVerifiedProofs": [
      "continuedUse",
      "listing",
      "hostAck",
      "sameBinding",
      "serviceVerifier"
    ],
    "listingAndServiceVerifierObservedNotAfterState": "host_receipt_pending",
    "hostAckObservedAfterState": "host_receipt_pending",
    "allProofsObservedNotAfterState": "closed_loop_verified",
    "productCreditClaimed": false,
    "paymentClosureAllowed": false
  },
  "externalEvidenceBoundary": {
    "packageMayValidateStructure": true,
    "packageMayVerifyExternalReceiptAuthenticity": false,
    "packageMaySelfPromoteState": false,
    "repositoryTestIsNotHostReceipt": true,
    "schemaValidationOrRepositoryValidationIsNotReceiptAuthenticity": true,
    "externalEvidenceFieldsRemainUntrustedUntilAuthorizedVerification": true
  },
  "cannotProve": [
    "real host execution or continued-use consumption",
    "external receipt signature authenticity or replay consumption",
    "official listing acceptance or host ACK",
    "service-side consent verification",
    "natural traffic product credit or payment closure"
  ]
}
