{
  "schemaVersion": "long_manuscript.native_capability_absorption.v1",
  "packageVersion": "26.7.18",
  "nativeOnly": true,
  "runtimeDependencyRequired": false,
  "capabilities": [
    {"capabilityId":"project_anchor_and_gated_progression","contract":"schemas/manuscript-project-v1.schema.json","cannotProve":["external project workspace write without explicit user request"]},
    {"capabilityId":"bounded_recovery_and_human_locks","contract":"contracts/project-workflow-contract.json","cannotProve":["trusted external approval without a verifier"]},
    {"capabilityId":"continuity_and_revision_trace","contract":"schemas/manuscript-project-v1.schema.json","cannotProve":["semantic quality of unprovided source material"]},
    {"capabilityId":"research_scope_provenance_and_freshness","contract":"templates/research-brief.json","cannotProve":["current-source verification when no source is provided"]},
    {"capabilityId":"incremental_large_manuscript_review","contract":"templates/scale-review-policy.json","cannotProve":["on-disk word count without a user-provided artifact"]},
    {"capabilityId":"docx_format_export_review","contract":"schemas/post-draft-result-v1.schema.json#/formatExportReview","cannotProve":["actual DOCX or PDF rendering without an authorized renderer"]},
    {"capabilityId":"single_primary_revision_gap","contract":"templates/revision-gap-selection.json","cannotProve":["user acceptance of the proposed next action"]}
  ],
  "prohibitedInheritance": [
    "source_plugin_identity", "source_plugin_brand", "source_plugin_license", "source_runtime_receipt", "source_host_binding", "source_connector", "source_publish_permission", "source_product_credit", "source_marketplace_status"
  ],
  "acceptanceRule": "All capability fixtures and validators must run when the source expert directories are unavailable."
}
