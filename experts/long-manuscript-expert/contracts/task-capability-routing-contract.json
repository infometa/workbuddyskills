{
  "schemaVersion": "long_manuscript.task_capability_routing_contract.v1",
  "packageVersion": "26.7.18",
  "enforcementTopology": {
    "repositoryValidatorModule": "lib/task-capability-routing.mjs",
    "validatorScope": "workspace_root_review_only",
    "validatorIncludedInProductZip": false,
    "schemaIsNotAnExecutableValidator": true,
    "hostExecutionProven": false,
    "crossFieldEqualityEnforcement": "repository_validator_only"
  },
  "decisionSchema": "schemas/task-capability-route-v1.schema.json",
  "scenarioFixture": "fixtures/behavior/r8-task-capability-routing-scenarios.json",
  "selectionAuthority": {
    "packageSelects": "task_class_and_required_capabilities_only",
    "hostSelects": "concrete_model_or_runtime_only_with_host_receipt",
    "namedModelInPackageDecisionAllowed": false,
    "clientSuppliedModelClaimTrusted": false
  },
  "capabilityVocabulary": [
    "long_context_reasoning",
    "structured_output",
    "anchored_diff",
    "claim_evidence_tracking",
    "continuity_tracking",
    "bounded_rewrite",
    "current_source_retrieval",
    "document_renderer"
  ],
  "routes": [
    {
      "taskClass": "first_value",
      "requiredCapabilities": ["long_context_reasoning", "structured_output"],
      "optionalCapabilities": ["claim_evidence_tracking"],
      "defaultExecutionMode": "package_native_text",
      "missingCapabilityPolicy": "fail_closed"
    },
    {
      "taskClass": "continued_use",
      "requiredCapabilities": ["long_context_reasoning", "structured_output", "continuity_tracking"],
      "optionalCapabilities": ["claim_evidence_tracking"],
      "defaultExecutionMode": "package_native_text",
      "missingCapabilityPolicy": "fail_closed"
    },
    {
      "taskClass": "anchored_revision",
      "requiredCapabilities": ["anchored_diff", "bounded_rewrite"],
      "optionalCapabilities": ["long_context_reasoning", "claim_evidence_tracking"],
      "defaultExecutionMode": "package_native_text",
      "missingCapabilityPolicy": "fail_closed"
    },
    {
      "taskClass": "quality_review",
      "requiredCapabilities": ["structured_output", "claim_evidence_tracking"],
      "optionalCapabilities": ["long_context_reasoning", "anchored_diff"],
      "defaultExecutionMode": "package_native_text",
      "missingCapabilityPolicy": "fail_closed"
    },
    {
      "taskClass": "current_evidence_upgrade",
      "requiredCapabilities": ["claim_evidence_tracking", "current_source_retrieval"],
      "optionalCapabilities": ["long_context_reasoning"],
      "defaultExecutionMode": "authorized_external_research",
      "missingCapabilityPolicy": "draft_only_blocked_external"
    },
    {
      "taskClass": "post_draft_transform",
      "requiredCapabilities": ["bounded_rewrite", "structured_output"],
      "optionalCapabilities": ["anchored_diff", "continuity_tracking"],
      "defaultExecutionMode": "package_native_text",
      "missingCapabilityPolicy": "fail_closed"
    },
    {
      "taskClass": "format_export",
      "requiredCapabilities": ["structured_output", "document_renderer"],
      "optionalCapabilities": ["anchored_diff"],
      "defaultExecutionMode": "authorized_document_renderer",
      "missingCapabilityPolicy": "plan_only_blocked_external"
    }
  ],
  "externalCapabilityIds": ["current_source_retrieval", "document_renderer"],
  "decisionRules": [
    "A route is ready only when every required capability is observed in the current execution surface.",
    "Missing external capabilities may return a useful draft or plan only when the route declares that fallback; the result remains blocked_external for the missing operation.",
    "A package decision must not name, recommend, imply, or self-attest a concrete model or provider.",
    "Host model or runtime selection cannot become product evidence without a receipt bound to the current package digest and task decision."
  ],
  "cannotProve": [
    "which models or providers the host currently offers",
    "host capability quality cost latency or availability",
    "that a host-selected runtime executed this route without an external receipt"
  ]
}
