{
  "schemaVersion": "long_manuscript.execution_topology.v1",
  "contractId": "long-manuscript-execution-topology",
  "packageVersion": "26.7.18",
  "productZip": {
    "containsRepositoryValidatorModules": false,
    "containsExecutableJsRuntimeSpine": false,
    "schemaIsNotAnExecutableValidator": true,
    "scope": "declarative_agent_and_contract_assets_only"
  },
  "repositoryValidation": {
    "scope": "workspace_root_review_only",
    "hostExecutionProven": false,
    "notAHostRuntimeReceipt": true
  },
  "enforcementTargets": [
    {
      "targetId": "R1_first_value_artifact",
      "contractRef": "contracts/first-value-artifact-contract.json",
      "schemaRefs": ["schemas/first-value-artifact-v1.schema.json"],
      "repositoryValidatorModule": "lib/first-value-artifact-contract.mjs",
      "crossFieldEqualityEnforcement": "repository_validator_only"
    },
    {
      "targetId": "R2_anchored_revision_and_high_risk_brief",
      "contractRef": "contracts/anchored-revision-contract.json",
      "schemaRefs": [
        "schemas/anchored-revision-v1.schema.json",
        "schemas/high-risk-vertical-brief-v1.schema.json"
      ],
      "repositoryValidatorModule": "lib/anchored-revision-contract.mjs",
      "crossFieldEqualityEnforcement": "repository_validator_only"
    },
    {
      "targetId": "R3_fiction_continuity",
      "contractRef": "contracts/fiction-continuity-contract.json",
      "schemaRefs": ["schemas/fiction-continuity-canon-v1.schema.json"],
      "repositoryValidatorModule": "lib/fiction-continuity-contract.mjs",
      "crossFieldEqualityEnforcement": "repository_validator_only"
    },
    {
      "targetId": "R4_docx_delivery_preflight",
      "contractRef": "contracts/docx-delivery-contract.json",
      "schemaRefs": ["schemas/docx-delivery-plan-v1.schema.json"],
      "repositoryValidatorModule": "lib/docx-delivery-contract.mjs",
      "crossFieldEqualityEnforcement": "repository_validator_only"
    },
    {
      "targetId": "R7_manuscript_quality_gate",
      "contractRef": "contracts/manuscript-quality-gate-contract.json",
      "schemaRefs": ["schemas/manuscript-quality-report-v1.schema.json"],
      "repositoryValidatorModule": "lib/manuscript-quality-gate.mjs",
      "repositorySupportingModules": ["lib/manuscript-quality-evidence-alignment.mjs"],
      "crossFieldEqualityEnforcement": "repository_validator_only"
    },
    {
      "targetId": "R7_claim_evidence_coverage",
      "contractRef": "contracts/claim-evidence-coverage-contract.json",
      "schemaRefs": ["schemas/claim-evidence-map-v1.schema.json"],
      "repositoryValidatorModule": "lib/claim-evidence-coverage.mjs",
      "repositorySupportingModules": ["lib/manuscript-quality-evidence-alignment.mjs"],
      "crossFieldEqualityEnforcement": "repository_validator_only"
    },
    {
      "targetId": "R8_lebao_consent_record_only_gate",
      "contractRef": "contracts/lebao-consent-contract.json",
      "schemaRefs": ["schemas/lebao-consent-v1.schema.json"],
      "repositoryValidatorModule": "lib/lebao-consent.mjs",
      "crossFieldEqualityEnforcement": "repository_validator_only"
    },
    {
      "targetId": "R8_continued_use_and_role_governance",
      "contractRef": "contracts/continued-use-governance-contract.json",
      "schemaRefs": ["schemas/continued-use-card-v1.schema.json"],
      "repositoryValidatorModule": "lib/continued-use-governance.mjs",
      "repositorySupportingModules": ["lib/project-workflow-contract.mjs"],
      "crossFieldEqualityEnforcement": "repository_validator_only"
    },
    {
      "targetId": "R8_canonical_closed_loop_state",
      "contractRef": "contracts/closed-loop-state-contract.json",
      "schemaRefs": ["schemas/closed-loop-state-record-v1.schema.json"],
      "repositoryValidatorModule": "lib/closed-loop-state.mjs",
      "repositorySupportingModules": ["lib/lebao-consent.mjs"],
      "crossFieldEqualityEnforcement": "repository_validator_only"
    },
    {
      "targetId": "R8_task_capability_routing",
      "contractRef": "contracts/task-capability-routing-contract.json",
      "schemaRefs": ["schemas/task-capability-route-v1.schema.json"],
      "repositoryValidatorModule": "lib/task-capability-routing.mjs",
      "crossFieldEqualityEnforcement": "repository_validator_only"
    }
  ],
  "forbiddenClaims": [
    "product_zip_contains_repository_js_validator",
    "product_zip_contains_host_runtime_spine",
    "schema_validation_proves_host_execution",
    "repository_side_test_proves_listing_or_natural_traffic"
  ]
}
