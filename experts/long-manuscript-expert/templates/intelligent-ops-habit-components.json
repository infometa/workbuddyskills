{
  "schemaVersion": "long_manuscript.intelligent_ops_habit_components.v1",
  "version": "1.0.0",
  "purpose": "Define service-readable, user-controlled continuation components for healthy high-frequency manuscript use.",
  "sourceInformedPrinciples": [
    {
      "principleId": "behavior_prompt_after_ability",
      "summary": "Continuation prompts should appear after the user already has enough value and ability to take the next step."
    },
    {
      "principleId": "transparent_progress",
      "summary": "Progress cards must explain what changed, what remains, and why the next action is recommended."
    },
    {
      "principleId": "user_control_and_opt_out",
      "summary": "Personalization, return prompts, and benefit guidance must be optional, visible, and easy to ignore."
    },
    {
      "principleId": "no_dark_patterns",
      "summary": "Do not use guilt streaks, false scarcity, hidden pressure, deceptive urgency, or emotional dependency hooks."
    }
  ],
  "healthyHabitLoopPolicy": {
    "preferredLabel": "healthy_continuation_loop",
    "userVisibleIntent": "Help the user return to a useful manuscript next step without pressure.",
    "allowedPatterns": [
      "progress_summary",
      "single_next_best_action",
      "two_or_three_user_controlled_options",
      "resume_prompt",
      "transparent_lebao_eligibility_boundary",
      "cooldown_or_stop_signal_when_the_user_is_done"
    ],
    "forbiddenPatterns": [
      "guilt_streak",
      "false_scarcity",
      "hidden_or_irreversible_claim",
      "claim_or_unlock_without_receipt",
      "payment_closure_from_benefit_state",
      "dark_pattern_personalization",
      "pressure_to_continue_after_user_stops"
    ],
    "userControlFields": [
      "resumePrompt",
      "optOutAllowed",
      "reopenIntakeAllowed",
      "stopCondition",
      "cooldownReason"
    ]
  },
  "valueEventContract": {
    "metadataPreferred": true,
    "defaultUserVisible": false,
    "schemaVersion": "fbs.valueEvent.v1",
    "requiredFields": [
      "schemaVersion",
      "eventType",
      "productId",
      "canonicalProductId",
      "expertEntryId",
      "packCode",
      "servicePackCode",
      "scenePackId",
      "entryId",
      "entryPromptCode",
      "channelTrack",
      "sameBinding",
      "currentMilestone",
      "nextTool",
      "stopCondition",
      "productCreditClaimed",
      "paymentClosureAllowed",
      "probeRowsDiagnosticOnly"
    ],
    "routeFieldAliases": {
      "packCode": "primary",
      "servicePackCode": "compat_alias"
    },
    "allowedEventTypes": [
      "first_value_completed",
      "same_binding_followthrough_ready",
      "continued_use_completed",
      "lebao_receipt_eligible"
    ],
    "defaultBoundaryValues": {
      "productCreditClaimed": false,
      "paymentClosureAllowed": false,
      "probeRowsDiagnosticOnly": true
    }
  },
  "personalizationProfileContract": {
    "identityMode": "anonymous_first_delayed_identify",
    "forbiddenFields": [
      "pii_email",
      "pii_phone",
      "stable_user_id",
      "raw_user_identifier"
    ],
    "fields": [
      "profileSegment",
      "intentFamily",
      "cohortProfileSegment",
      "cohortIntentFamily",
      "documentArchetype",
      "sourceMaturity",
      "deliveryStage",
      "readerUseContext",
      "evidenceComplianceMode",
      "postDraftLane",
      "projectTemplate",
      "preferredNextBranches",
      "deidentifiedCohortKey"
    ],
    "canonicalDefaults": {
      "intentFamily": "writing",
      "profileSegment": "creator"
    },
    "creditBoundary": "Personalization helps strategy dispatch but does not prove product credit."
  },
  "deliveryTaskboardContract": {
    "metadataPreferred": true,
    "defaultUserVisible": false,
    "requiredTaskFields": [
      "taskId",
      "branch",
      "ownerSurface",
      "sideEffectClass",
      "requiredInputs",
      "acceptance",
      "doneState",
      "successorAction",
      "sameBindingRequired",
      "lebaoEligibleAfter"
    ],
    "defaultSideEffectClass": "read_only",
    "defaultOwnerSurface": "package_or_service_orchestration",
    "defaultLebaoEligibleAfter": "continued_use_completed"
  },
  "opsBoardContract": {
    "metadataPreferred": true,
    "defaultUserVisible": false,
    "requiredFields": [
      "currentStage",
      "loopStatus",
      "recordOnly",
      "writesProductionState",
      "productCreditPromotionAllowed",
      "currentBlocker",
      "nextOwnerAction",
      "stopCondition",
      "cannotProve"
    ],
    "defaultValues": {
      "recordOnly": true,
      "writesProductionState": false,
      "productCreditPromotionAllowed": false
    }
  },
  "lebaoUnlockLadder": {
    "steps": [
      {
        "stepId": "value_seen",
        "eventType": "first_value_completed",
        "userMessageBoundary": "The user has received usable manuscript value.",
        "lebaoClaimAllowed": false
      },
      {
        "stepId": "same_binding_ready",
        "eventType": "same_binding_followthrough_ready",
        "userMessageBoundary": "The next action can preserve the same anonymous binding if the host or service forwards it.",
        "lebaoClaimAllowed": false
      },
      {
        "stepId": "continued_use_done",
        "eventType": "continued_use_completed",
        "userMessageBoundary": "The user has completed a real continuation action.",
        "lebaoEligibilityCandidate": true,
        "lebaoClaimAllowed": false
      },
      {
        "stepId": "receipt_eligible",
        "eventType": "lebao_receipt_eligible",
        "userMessageBoundary": "A strict receipt may be collected when identity, route signature, benefit state, same-binding evidence, and host action envelope are present.",
        "lebaoEligibilityCandidate": true,
        "lebaoClaimAllowed": true
      }
    ],
    "claimTool": "lebao_claim",
    "unlockNotBefore": "continued_use_completed",
    "paymentClosureAllowed": false,
    "requiredReceiptFieldGroups": [
      "identity",
      "routeSignature",
      "benefitState",
      "sameBindingEvidence",
      "hostActionEnvelope"
    ]
  },
  "highFrequencyEntryMatrix": [
    {
      "entryId": "continue_next_chapter",
      "postDraftBranch": "continue_chapter",
      "expectedInput": "target chapter or section",
      "stopCondition": "next_section_delivered_with_updated_progress_card"
    },
    {
      "entryId": "de_ai_polish_pass",
      "postDraftBranch": "de_ai_polish",
      "expectedInput": "draft excerpt and polish strength",
      "stopCondition": "tone_repair_examples_and_risk_notes_delivered"
    },
    {
      "entryId": "format_export_precheck",
      "postDraftBranch": "format_export",
      "expectedInput": "target export format",
      "stopCondition": "layout_and_export_checklist_delivered"
    },
    {
      "entryId": "material_archive_pack",
      "postDraftBranch": "organize_materials",
      "expectedInput": "source inventory or scattered notes",
      "stopCondition": "material_inventory_and_gap_split_delivered"
    },
    {
      "entryId": "channel_repurpose_pack",
      "postDraftBranch": "repurpose_channels",
      "expectedInput": "target channels and manuscript summary",
      "stopCondition": "channel_assets_and_content_operations_handoff_delivered"
    },
    {
      "entryId": "distribution_plan_pack",
      "postDraftBranch": "distribution_plan",
      "expectedInput": "publishing window and launch constraints",
      "stopCondition": "distribution_plan_and_release_checklist_delivered"
    },
    {
      "entryId": "summary_pack_builder",
      "postDraftBranch": "summary_pack",
      "expectedInput": "summary formats and target readers",
      "stopCondition": "summary_assets_delivered"
    },
    {
      "entryId": "visual_brief_builder",
      "postDraftBranch": "visual_brief",
      "expectedInput": "image style or use case",
      "stopCondition": "visual_brief_delivered"
    }
  ]
}
