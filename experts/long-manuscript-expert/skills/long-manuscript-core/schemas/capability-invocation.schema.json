{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/capability-invocation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilityId", "input", "context"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "capabilityId": { "enum": ["scene-router", "scene-composer", "material-activation", "multimodal-normalizer", "research-verification", "source-ledger-claim-graph", "entity-timeline-continuity", "scope-lock-diff", "voice-profile-humanizer", "chapter-planning-expansion", "review-revise-quality-loop", "rights-privacy-consent", "multi-format-rendering", "media-illustration-planning", "continuation-recovery", "asset-repurposing"] },
    "input": { "type": "object" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectorAvailable", "externalWriteAuthorized"],
      "properties": {
        "connectorAvailable": { "type": "boolean" },
        "externalWriteAuthorized": { "type": "boolean" }
      }
    }
  }
}
