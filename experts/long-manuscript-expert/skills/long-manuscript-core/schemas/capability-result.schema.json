{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/capability-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["capabilityId", "status", "ok", "output", "issues", "warnings", "context", "receipt"],
  "properties": {
    "capabilityId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "output": { "type": "object" },
    "issues": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "warnings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectorAvailable", "externalWriteAuthorized"],
      "properties": {
        "connectorAvailable": { "type": "boolean" },
        "externalWriteAuthorized": { "type": "boolean" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "capabilityId", "inputDigest", "contextDigest", "invocationDigest", "policyDigest", "resultDigest", "externalActionCount", "connectorRequired", "donorSkillUsed"],
      "properties": {
        "schemaVersion": { "const": "1.1.0" },
        "capabilityId": { "type": "string", "minLength": 1 },
        "inputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "invocationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resultDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "externalActionCount": { "const": 0 },
        "connectorRequired": { "const": false },
        "donorSkillUsed": { "const": false }
      }
    }
  }
}
