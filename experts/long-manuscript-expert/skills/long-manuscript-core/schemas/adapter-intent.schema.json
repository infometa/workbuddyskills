{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/adapter-intent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sceneId", "portId", "operation", "adapterId", "adapterOperation", "bindingScope", "purpose", "minimumDataScope", "dataFields", "targetDescriptorDigest", "payloadDigest", "expectedReadbackDigest", "idempotencyKeyDigest", "providerRegistryDigest", "providerBindingDigest", "sceneBindingDigest", "sameBindingPolicyDigest", "writeMode", "approvalRequired", "readbackRequired", "freshTargetResolutionRequired", "sameBindingRequired", "fallback", "executionAllowed", "intentDigest"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "sceneId": { "type": "string", "minLength": 1 },
    "portId": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "adapterId": { "enum": ["wecom", "fbs"] },
    "adapterOperation": { "type": "string", "minLength": 1 },
    "bindingScope": { "enum": ["scene_optional_binding", "product_control_binding"] },
    "purpose": { "type": "string", "minLength": 1 },
    "minimumDataScope": { "type": "string", "minLength": 1 },
    "dataFields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "targetDescriptorDigest": { "$ref": "#/$defs/digest" },
    "payloadDigest": { "$ref": "#/$defs/digest" },
    "expectedReadbackDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "idempotencyKeyDigest": { "$ref": "#/$defs/digest" },
    "providerRegistryDigest": { "$ref": "#/$defs/digest" },
    "providerBindingDigest": { "$ref": "#/$defs/digest" },
    "sceneBindingDigest": { "$ref": "#/$defs/digest" },
    "sameBindingPolicyDigest": { "$ref": "#/$defs/digest" },
    "writeMode": { "enum": ["read_only", "external_write"] },
    "approvalRequired": { "type": "boolean" },
    "readbackRequired": { "type": "boolean" },
    "freshTargetResolutionRequired": { "type": "boolean" },
    "sameBindingRequired": { "type": "boolean" },
    "fallback": { "const": "local_workflow_without_connector" },
    "executionAllowed": { "const": false },
    "intentDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
