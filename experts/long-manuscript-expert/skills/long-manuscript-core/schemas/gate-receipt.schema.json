{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/gate-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gateId",
    "parameterProfile",
    "sceneId",
    "invocationDigest",
    "evaluatorDigest",
    "registryDigest",
    "profileDigest",
    "scenePackDigest",
    "evidenceSnapshotDigest",
    "artifactSetDigest",
    "resultDigest",
    "decision",
    "externalActionCount",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "gateId": {
      "type": "string"
    },
    "parameterProfile": {
      "type": [
        "string",
        "null"
      ]
    },
    "sceneId": {
      "type": "string"
    },
    "invocationDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluatorDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "registryDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "profileDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scenePackDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceSnapshotDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactSetDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "passed",
        "blocked"
      ]
    },
    "externalActionCount": {
      "const": 0
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
