{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/scope-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lockId", "allowedScopes", "forbiddenScopes", "originalDigests", "approvalState"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "lockId": { "type": "string" },
    "allowedScopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "forbiddenScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "originalDigests": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "approvalState": { "enum": ["implicit_exact_selection", "explicit", "needs_clarification"] }
  }
}
