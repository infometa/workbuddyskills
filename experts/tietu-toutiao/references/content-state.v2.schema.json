{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-state.v2",
  "title": "Tietu Toutiao content state (v2: items + layout analysis + editorial log)",
  "type": "object",
  "required": [
    "schema_version",
    "source_image",
    "masthead",
    "date",
    "headline",
    "primary_photo",
    "selected_template",
    "locked_fields",
    "rejected_styles",
    "revision_id",
    "parent_revision_id",
    "source_manifest",
    "layout_analysis",
    "items",
    "editorial_log"
  ],
  "properties": {
    "schema_version": { "const": "content-state.v2" },
    "source_manifest": {
      "type": "object",
      "required": ["sources", "ingested_at", "ingest_method"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file", "sha256"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              "pages_used": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
              "page_label": { "type": "string" }
            }
          }
        },
        "ingested_at": { "type": "string", "minLength": 1 },
        "ingest_method": { "type": "string", "minLength": 1 }
      }
    },
    "layout_analysis": {
      "type": "object",
      "required": ["photo_regions", "analyzer", "confirmed"],
      "properties": {
        "masthead_bbox": { "$ref": "#/$defs/bbox" },
        "date_bbox": { "$ref": "#/$defs/bbox" },
        "photo_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bbox", "kind", "confidence"],
            "properties": {
              "bbox": { "$ref": "#/$defs/bbox" },
              "kind": { "type": "string", "minLength": 1 },
              "subject": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "text_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bbox", "kind"],
            "properties": {
              "bbox": { "$ref": "#/$defs/bbox" },
              "kind": { "type": "string", "minLength": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "analyzer": { "type": "string", "minLength": 1 },
        "confirmed": { "type": "boolean" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "headline", "weight", "selected"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
          "type": { "type": "string", "minLength": 1 },
          "headline": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "source_page": { "type": "string" },
          "photo_region_ref": { "type": "integer", "minimum": 0 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "scores": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "selected": { "type": "boolean" }
        }
      }
    },
    "editorial_log": {
      "type": "object",
      "required": ["narrative", "excluded", "model", "generated_at"],
      "properties": {
        "narrative": { "type": "string", "minLength": 1 },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "model": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 },
        "review": {
          "type": "object",
          "required": ["passed", "checks"],
          "properties": {
            "passed": { "type": "boolean" },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["item", "ok"],
                "properties": {
                  "item": { "type": "string", "minLength": 1 },
                  "ok": { "type": "boolean" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
