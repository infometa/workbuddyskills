{
  "specVersion": "1.0",
  "appId": "{{PROJECT_ID}}",
  "appName": "{{PROJECT_NAME}}",
  "description": "TODO: 用 2-3 句话描述本应用能做什么、适合什么场景。",
  "tools": [
    {
      "name": "list_items",
      "summary": "查询全部业务条目",
      "method": "GET",
      "path": "/app-mcp/api/items",
      "parameters": [],
      "callExample": {
        "good": "{}"
      },
      "response": {
        "description": "条目数组",
        "example": [ { "id": "kx2f9", "name": "示例条目", "createdAt": "2026-01-01T00:00:00.000Z" } ]
      }
    },
    {
      "name": "create_item",
      "summary": "新增一条业务条目",
      "method": "POST",
      "path": "/app-mcp/api/items",
      "parameters": [
        {
          "name": "item",
          "in": "body",
          "type": "object",
          "required": true,
          "description": "要新增的条目对象",
          "fields": [
            { "name": "name", "type": "string", "required": true, "description": "条目名称，1-50 字符" },
            { "name": "status", "type": "string", "required": false, "description": "状态枚举：pending / done，缺省 pending" },
            {
              "name": "tags",
              "type": "array",
              "required": false,
              "description": "标签列表",
              "fields": [ { "name": "tag", "type": "string", "required": true, "description": "单个标签文本，每个数组元素为 { \"tag\": string }" } ]
            }
          ]
        }
      ],
      "callExample": {
        "good": "{\"item\":{\"name\":\"示例条目\",\"status\":\"pending\",\"tags\":[{\"tag\":\"重点\"}]}}"
      },
      "response": {
        "description": "创建成功的条目",
        "example": { "id": "kx2f9a", "name": "条目名", "createdAt": "2026-01-01T00:00:00.000Z" }
      }
    },
    {
      "name": "update_item",
      "summary": "按 id 更新一条业务条目",
      "method": "PUT",
      "path": "/app-mcp/api/items/{id}",
      "parameters": [
        { "name": "id", "in": "path", "type": "string", "required": true, "description": "条目 id" },
        {
          "name": "item",
          "in": "body",
          "type": "object",
          "required": true,
          "description": "要更新的字段对象，只传需要修改的字段",
          "fields": [
            { "name": "name", "type": "string", "required": false, "description": "新的条目名称" },
            { "name": "status", "type": "string", "required": false, "description": "新的条目状态枚举：pending / done" }
          ]
        }
      ],
      "callExample": {
        "good": "{\"id\":\"kx2f9a\",\"item\":{\"name\":\"新名称\"}}"
      },
      "response": {
        "description": "更新后的完整条目",
        "example": { "id": "kx2f9a", "name": "新名称", "updatedAt": "2026-01-02T00:00:00.000Z" }
      }
    },
    {
      "name": "delete_item",
      "summary": "按 id 删除一条业务条目",
      "method": "DELETE",
      "path": "/app-mcp/api/items/{id}",
      "parameters": [
        { "name": "id", "in": "path", "type": "string", "required": true, "description": "条目 id" }
      ],
      "callExample": {
        "good": "{\"id\":\"kx2f9a\"}"
      },
      "response": {
        "description": "删除结果",
        "example": { "success": true }
      }
    }
  ]
}
