Agent Authz for Flask
Auto-generated by agent-boost. DO NOT EDIT MANUALLY (re-run /agent-boost to regenerate).

全局数据驱动授权：按 method+path 匹配授权清单规则，
依据透传来的 X-Staff-Name/X-Staff-Id 做授权判断。

用法（应用入口）：
    from agent_authz import register_agent_authz
    register_agent_authz(app)
"""
import json
import os
import re
import logging

from flask import request, jsonify

logger = logging.getLogger("agent-authz")

MANIFEST_ENV = "AGENT_AUTHZ_MANIFEST"
MANIFEST_REL = "${MANIFEST_PATH}"  # 相对项目根，默认 .agent/authz/api-authz.json


def _resolve_manifest_path() -> str:
    here = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.environ.get(MANIFEST_ENV),
        os.path.join(os.getcwd(), MANIFEST_REL),
        os.path.join(here, "..", MANIFEST_REL),
        os.path.join(here, MANIFEST_REL),
    ]
    for p in candidates:
        if p and os.path.exists(p):
            return p
    return candidates[1]


def _path_to_regex(p: str) -> "re.Pattern":
    esc = re.escape(p)
    esc = re.sub(r"\\\{[^/}]+\\\}", r"[^/]+", esc)   # {id}
    esc = re.sub(r":[^/]+", r"[^/]+", esc)            # :id
    return re.compile(r"^" + esc + r"/?$")


try:
    _MANIFEST = json.load(open(_resolve_manifest_path(), encoding="utf-8"))
except Exception as e:  # pragma: no cover
    logger.error("加载授权清单失败，将放行所有请求以免误伤: %s", e)
    _MANIFEST = {"enforcement": "none", "apis": []}

_HIERARCHY = _MANIFEST.get("roleHierarchy", ["public", "user", "admin"])
_RULES = [
    {"method": (a.get("method", "GET")).upper(),
     "required": a.get("requiredRole", "public"),
     "re": _path_to_regex(a.get("path", "/"))}
    for a in _MANIFEST.get("apis", [])
]


def _match_rule(method: str, url_path: str):
    m = (method or "GET").upper()
    for r in _RULES:
        if r["method"] == m and r["re"].match(url_path):
            return r
    return None


def _role_satisfies(held_roles, required: str) -> bool:
    if required == "public":
        return True
    held = set(held_roles or [])
    if required in held:
        return True
    if required in _HIERARCHY:
        ri = _HIERARCHY.index(required)
        for h in held:
            if h in _HIERARCHY and _HIERARCHY.index(h) >= ri:
                return True
    return False


def default_resolve_role(staff_name: str, staff_id: str):
    """内置默认 Resolver：处理清单中 static / env 型名单。"""
    roles = ["public"]
    if staff_name:
        roles.append("user")
    for role_name, dfn in (_MANIFEST.get("roles") or {}).items():
        src = (dfn or {}).get("source")
        if not src or not staff_name:
            continue
        if src.get("type") == "static" and staff_name in (src.get("members") or []):
            roles.append(role_name)
        elif src.get("type") == "env" and src.get("var"):
            lst = re.split(r"[,;\s]+", os.environ.get(src["var"], "").strip())
            if staff_name in [x for x in lst if x]:
                roles.append(role_name)
    return roles


# ============================================================
# Role Resolver（db / custom 型由 agent-boost 注入；static/env 用默认）
# 约定：def resolve_role(staff_name, staff_id) -> list[str]
# ============================================================
${ROLE_RESOLVER}


def register_agent_authz(app):
    @app.before_request
    def _agent_authz_guard():
        if _MANIFEST.get("enforcement", "middleware") != "middleware":
            return None
        rule = _match_rule(request.method, request.path)
        if not rule:
            return None
        required = rule["required"]
        if required == "public":
            return None
        staff_name = request.headers.get("X-Staff-Name", "")
        staff_id = request.headers.get("X-Staff-Id", "")
        if required == "user":
            if staff_name:
                return None
            return jsonify({"code": "unauthenticated", "message": "需要登录身份"}), 401
        try:
            roles = resolve_role(staff_name, staff_id)
            if _role_satisfies(roles, required):
                return None
            return jsonify({"code": "forbidden", "need": required,
                            "message": f"此操作需要 {required} 权限"}), 403
        except Exception as e:
            logger.error("授权判断异常: %s", e)
            return jsonify({"code": "forbidden", "message": "授权校验失败"}), 403
