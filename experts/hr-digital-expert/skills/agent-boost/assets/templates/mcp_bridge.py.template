import json
import os
import logging
import socket

import httpx
from mcp.server.fastmcp import FastMCP

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("mcp-bridge")

# ── 动态端口探测（避免多项目端口冲突）──
def _find_free_port(start: int = ${BRIDGE_PORT}, max_try: int = 100) -> int:
    """从 start 开始查找第一个可用端口（bind 探测，无竞态）"""
    for port in range(start, start + max_try):
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                s.bind(("127.0.0.1", port))
                return port
        except OSError:
            continue
    logger.warning(f"no free port in range {start}-{start + max_try}, falling back to {start}")
    return start

# ── 配置（通过环境变量覆盖）──
APP_BASE_URL = os.getenv("APP_BASE_URL", "http://localhost:${APP_PORT}")
BRIDGE_HOST = os.getenv("BRIDGE_HOST", "0.0.0.0")
BRIDGE_PORT = int(os.getenv("BRIDGE_PORT") or _find_free_port())
BRIDGE_NAME = os.getenv("BRIDGE_NAME", "${PROJECT_ID}-bridge")
PROJECT_ID = os.getenv("PROJECT_ID", BRIDGE_NAME.replace("-bridge", ""))

# 将实际端口写入文件，供注册时读取（agent-server 直连该端口）
_PORT_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".bridge-port")
try:
    with open(_PORT_FILE, "w") as f:
        f.write(str(BRIDGE_PORT))
except Exception as e:
    logger.warning(f"failed to write .bridge-port: {e}")

# ── 已知端点（agent-boost 分析阶段写入，agent 启动时调 list_endpoints 了解能做什么）──
KNOWN_ENDPOINTS = ${KNOWN_ENDPOINTS_JSON}

mcp = FastMCP(BRIDGE_NAME, stateless_http=True)


# ============================================================
# 终端用户身份解析（按调用透传真实用户，满足"不同用户不同权限"）
# ============================================================
def _resolve_caller() -> tuple:
    """从入站 MCP 请求解析真实终端用户身份 (staff_name, staff_id)。

    优先级：
      1) 入站 X-Staff-Name 头 —— agent-server 已按"当前对话用户"逐请求注入（真实用户）
      2) 环境变量 BRIDGE_STAFF_NAME/ID —— 无对话上下文时兜底（如本地脚本直连）
    """
    name, sid = "", ""
    try:
        req = mcp.get_context().request_context.request
        hdrs = req.headers if req is not None else {}
        name = hdrs.get("x-staff-name", "") or ""
        sid = hdrs.get("x-staff-id", "") or ""
    except Exception:
        pass  # 非 HTTP 上下文（如启动期）无请求，走环境变量兜底
    if not name:
        name = os.getenv("BRIDGE_STAFF_NAME", "")
        sid = sid or os.getenv("BRIDGE_STAFF_ID", "")
    return name, sid


# ============================================================
# 通用反向调用
# ============================================================
def call_api(method: str, path: str, params: dict = None, body: dict = None,
             headers: dict = None, timeout: float = 15.0) -> str:
    """调用本应用的任意 API。自动以"当前对话的真实用户"身份注入 SSO 身份头。"""
    method = method.upper()
    if method not in {"GET", "POST", "PUT", "DELETE", "PATCH"}:
        return json.dumps({"error": f"unsupported method: {method}"})
    url = APP_BASE_URL.rstrip("/") + "/" + (path or "").lstrip("/")
    # 组装请求头：用户自定义头 + 真实用户 SSO 身份头
    req_headers = dict(headers or {})
    staff_name, staff_id = _resolve_caller()
    if staff_name:
        req_headers.setdefault("x-staff-name", staff_name)
        req_headers.setdefault("x-staff-id", staff_id)
    try:
        with httpx.Client(timeout=timeout) as client:
            resp = client.request(
                method, url,
                params=params or None,
                json=body if body is not None else None,
                headers=req_headers if req_headers else None,
            )
        # 解析响应体（JSON 优先，回退纯文本）
        try:
            payload = resp.json()
        except ValueError:
            payload = resp.text
        # 错误响应（含 401/403 授权拒绝）透出 HTTP 状态码，
        # 便于 Agent 感知"无权限"以及 §5 权限测试判定。
        if resp.status_code >= 400:
            return json.dumps({"_http_status": resp.status_code, "error": payload},
                              ensure_ascii=False)
        return json.dumps(payload, ensure_ascii=False) if not isinstance(payload, str) else payload
    except httpx.TimeoutException:
        return json.dumps({"error": "request timeout", "url": url})
    except Exception as e:
        return json.dumps({"error": str(e), "url": url})


# ============================================================
# 通用工具（所有 bridge 必备）
# ============================================================

@mcp.tool()
def list_endpoints() -> str:
    """列出本应用暴露的所有 API 端点。LLM 第一次工作前必须先调用此工具了解能调用哪些 API。
    返回 JSON 数组，每项包含 method/path/summary/params 描述。"""
    return json.dumps(KNOWN_ENDPOINTS, ensure_ascii=False, indent=2)


@mcp.tool()
def call_api_tool(method: str, path: str, params: dict = None, body: dict = None) -> str:
    """调用本应用的任意 API（通用兜底工具）。method 为 GET/POST/PUT/DELETE/PATCH，path 如 /api/items。"""
    return call_api(method, path, params=params, body=body)


@mcp.tool()
def check_app_health() -> str:
    """检查本应用是否健康。优先调 /api/health，失败则尝试根路径。"""
    for p in ("/api/health", "/health", "/"):
        r = call_api("GET", p)
        if '"error"' not in r:
            return json.dumps({"status": "healthy", "endpoint": p})
    return json.dumps({"status": "unhealthy"})


