if __name__ == "__main__":
    import uvicorn

    logger.info(f"🔌 MCP Bridge starting → http://{BRIDGE_HOST}:{BRIDGE_PORT}/mcp")
    logger.info(f"   bridge_name = {BRIDGE_NAME}")
    logger.info(f"   app_base    = {APP_BASE_URL}")

    # 获取 FastMCP 生成的 Starlette app
    app = mcp.streamable_http_app()

    # 跨机器访问修复：FastMCP 内置的 TrustedHostMiddleware 会拒绝来自其他IP的
    # Host 头。用纯 ASGI middleware 包裹，将 Host 替换为 127.0.0.1:PORT，绕过校验。
    class _FixHostMiddleware:
        def __init__(self, inner, trusted_host):
            self.inner = inner
            self.trusted_host = trusted_host.encode()

        async def __call__(self, scope, receive, send):
            if scope["type"] == "http":
                new_headers = []
                for name, value in scope.get("headers", []):
                    if name == b"host":
                        new_headers.append((b"host", self.trusted_host))
                    else:
                        new_headers.append((name, value))
                scope["headers"] = new_headers
            await self.inner(scope, receive, send)

    wrapped = _FixHostMiddleware(app, f"127.0.0.1:{BRIDGE_PORT}")
    uvicorn.run(wrapped, host=BRIDGE_HOST, port=BRIDGE_PORT)
