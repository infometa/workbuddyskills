{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fbsir://mom-dialogue/source/2.0",
  "title": "Canonical Source Ledger Row",
  "x-schema-version": "2.0",
  "x-storage": "csv",
  "type": "object",
  "additionalProperties": false,
  "required": ["root_id", "scan_id", "source_id", "source_key", "relative_path", "media_type", "status", "needs_reanalysis"],
  "properties": {
    "root_id": {"type": "string", "pattern": "^ROOT-[A-Z0-9]{12,64}$"},
    "root_label": {"type": "string"},
    "scan_id": {"type": "string", "pattern": "^SCAN-[A-Z0-9]{12,64}$"},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9]{12,64}$"},
    "source_key": {"type": "string", "minLength": 1},
    "relative_path": {"type": "string", "minLength": 1},
    "path_history": {"type": "string", "x-csvEncoding": "json-array"},
    "media_type": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "size_bytes": {"type": "string", "pattern": "^$|^[0-9]+$"},
    "modified_ns": {"type": "string", "pattern": "^$|^[0-9]+$"},
    "source_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "provider": {"type": "string"},
    "narrator": {"type": "string"},
    "visibility": {"enum": ["pending", "private", "selected_family", "family", "public"]},
    "manuscript_use": {"enum": ["pending", "no", "yes"]},
    "public_use": {"enum": ["pending", "no", "yes"]},
    "status": {"enum": ["active", "modified", "missing", "unreadable", "pending"]},
    "needs_reanalysis": {"enum": ["yes", "no"]},
    "scan_error": {"type": "string"},
    "first_seen_at": {"type": "string"},
    "last_seen_at": {"type": "string"},
    "notes": {"type": "string"}
  }
}
