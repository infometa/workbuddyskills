{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fbsir://mom-dialogue/delivery-selection/2.0",
  "title": "Explicit Delivery Selection",
  "x-schema-version": "2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_id", "scope", "created_at", "outputs", "source_ids", "story_ids", "answer_ids", "person_ids", "anonymized_object_ids", "sensitive_reviewed_object_ids"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "selection_id": {"type": "string", "pattern": "^DEL-[A-Z0-9]{12,64}$"},
    "scope": {"enum": ["manuscript", "public"]},
    "created_at": {"type": "string", "format": "date-time"},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[A-Z0-9]{12,64}$"}, "uniqueItems": true},
    "story_ids": {"type": "array", "items": {"type": "string", "pattern": "^STY-[A-Z0-9][A-Z0-9_-]{2,63}$"}, "uniqueItems": true},
    "answer_ids": {"type": "array", "items": {"type": "string", "pattern": "^ANS-[A-Z0-9][A-Z0-9_-]{2,63}$"}, "uniqueItems": true},
    "person_ids": {"type": "array", "items": {"type": "string", "pattern": "^PER-[A-Z0-9][A-Z0-9_-]{2,63}$"}, "uniqueItems": true},
    "anonymized_object_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sensitive_reviewed_object_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": "string"}
  }
}
