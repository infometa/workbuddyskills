{
  "schema": "industrial-park-investment-attraction-artifact-action-contract/v1",
  "contractVersion": "1.0.0",
  "packageVersion": "26.7.27",
  "defaultFirstValueSurface": "chat_response_only",
  "workspaceWriteRequiresExplicitUserIntent": true,
  "supportedPreparedFormats": [
    "chat_table",
    "markdown",
    "json",
    "csv",
    "verification_preparation_pack",
    "authorization_draft",
    "task_applicable_custom_format"
  ],
  "semanticWriter": "artifact-renderer",
  "semanticMutationAllowed": false,
  "semanticIntegrityFields": [
    "task_context",
    "source_records",
    "claim_evidence_links",
    "knowledge_records",
    "task_assessment",
    "task_deliverable_requirements",
    "delivered_artifact_refs",
    "visible_delivery_receipts",
    "next_actions",
    "candidate_set",
    "candidate_order",
    "legal_entity",
    "fit_band",
    "candidate_state",
    "evidence_refs",
    "counterevidence",
    "unknowns",
    "task_goal",
    "task_goal_hash",
    "task_state",
    "delivery_batches",
    "current_batch",
    "cumulative_unique_delivered_count",
    "count_goal_assessment",
    "coverage_assessments",
    "unmet_requirement_refs",
    "terminal_proof",
    "pause_reason",
    "next_cursor",
    "delivery_depth",
    "outcome_level",
    "qualification_checks",
    "action_readiness",
    "acquisition_plan",
    "portfolio_strategy",
    "performance_observation"
  ],
  "semanticIntegrityFieldPolicy": "preserve_only_fields_applicable_and_present_in_the_input_asset_never_fabricate_candidate_or_park_fields_for_generic_tasks",
  "csvFormulaInjectionProtectionRequired": true,
  "externalActions": {
    "toolCount": 0,
    "allowed": false,
    "allowedPreparedArtifacts": [
      "VerificationPreparationPack",
      "AuthorizationDraft"
    ],
    "verificationPreparationPackSchema": "schemas/verification-preparation-pack.schema.json",
    "authorizationDraftSchema": "schemas/authorization-draft.schema.json",
    "executedActionsMustBeEmpty": true,
    "maximumOutcomeLevel": "O5",
    "forbiddenCompletionClaims": [
      "sent",
      "written_to_crm",
      "contacted",
      "meeting_scheduled",
      "reply_received"
    ]
  }
}
