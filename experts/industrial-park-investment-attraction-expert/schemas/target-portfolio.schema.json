            "between",
            "none"
          ]
        },
        "exactCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "minimumCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maximumCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "achieved": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "not_applicable",
            "met",
            "below_minimum",
            "above_maximum",
            "unsupported"
          ]
        }
      }
    },
    "coverageAssessment": {
      "type": "object",
