          "type": "string",
          "minLength": 1
        },
        "entityRef": {
          "type": "string",
          "minLength": 1
        },
        "legalEntityName": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "evidenceRefs": {
          "$ref": "#/$defs/referenceList"
        },
        "failedConstraintRefs": {
          "$ref": "#/$defs/referenceList"
        },
        "contradictingClaimRefs": {
          "$ref": "#/$defs/referenceList"
        }
      }
