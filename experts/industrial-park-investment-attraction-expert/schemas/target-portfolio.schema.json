        "customerOperationSequence",
        "selectionBasis",
        "executionBoundary"
      ],
      "properties": {
        "primaryMotion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "supportingMotions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "channelMixRationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "customerOperationSequence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "selectionBasis": {
          "const": "task_goal_and_candidate_evidence_not_archetype_template"
        },
        "executionBoundary": {
