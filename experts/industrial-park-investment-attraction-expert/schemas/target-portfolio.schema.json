          "type": "integer",
          "minimum": 0
        },
        "sourcesRead": {
          "type": "integer",
          "minimum": 0
        },
        "checkpointReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "uncoveredDirections": {
