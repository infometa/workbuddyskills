          "type": "string",
          "minLength": 1
        },
        "requiredDistinctQualifiedEntities": {
          "type": "integer",
          "minimum": 1
        },
        "achievedDistinctQualifiedEntities": {
          "type": "integer",
          "minimum": 0
        },
        "matchedCandidateRefs": {
          "$ref": "#/$defs/referenceList"
