        },
        "goalFitGate": {
          "const": "pass"
        },
        "evidenceGate": {
          "const": "pass"
        },
        "unresolvedDuplicateCount": {
          "const": 0
        },
        "duplicatesMergedCount": {
          "type": "integer",
          "minimum": 0
        },
        "fatalEntityErrorCount": {
          "const": 0
        },
        "actionReadyCount": {
          "type": "integer",
          "minimum": 0
        },
        "needsActionPreparationCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nextAction": {
