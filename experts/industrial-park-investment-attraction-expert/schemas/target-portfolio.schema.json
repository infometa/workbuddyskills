    "qualificationCriterionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionRef",
        "required",
        "matchedCandidateRefs",
        "evidenceRefs",
        "status"
      ],
      "properties": {
        "criterionRef": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "matchedCandidateRefs": {
          "$ref": "#/$defs/referenceList"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/referenceList"
        },
        "status": {
          "enum": [
            "unmet",
            "met",
            "not_applicable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "met"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceRefs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "excludedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "entityRef",
        "legalEntityName",
        "reasonCode",
        "reason",
        "evidenceRefs",
        "failedConstraintRefs",
        "contradictingClaimRefs"
      ],
      "properties": {
