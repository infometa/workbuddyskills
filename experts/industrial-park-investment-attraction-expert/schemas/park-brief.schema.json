    "evidenceTemporalRequirement": {
      "enum": [
        "current_state",
        "effective_at_as_of",
        "point_in_time"
      ],
      "description": "Required temporal meaning of claims used for this judgment. stable_identity is reserved for legal-entity identity and cannot satisfy a park constraint."
    },
    "inputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "sourceKind",
        "redactedSummary",
        "normalizedContentHash",
        "sessionBindingHash",
        "turnBindingHash",
        "recordedAt",
        "confirmationState",
        "trustState",
        "authorizationState"
      ],
      "properties": {
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "sourceKind": {
          "enum": [
            "current_turn",
            "user_confirmed_context"
          ]
        },
        "redactedSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "normalizedContentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Content-integrity checksum only. It does not authenticate the user, session, turn, or authorization."
        },
        "sessionBindingHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "turnBindingHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "confirmationState": {
          "enum": [
            "explicit",
            "confirmed"
          ]
        },
        "trustState": {
          "enum": [
            "synthetic_fixture_assumption",
            "runtime_observed_not_machine_verifiable"
          ],
          "description": "Source examples use synthetic_fixture_assumption. Runtime business payloads may record an observation but cannot self-authenticate it."
        },
        "authorizationState": {
          "const": "not_proven_by_business_payload",
          "description": "Actual current-turn/user authorization belongs to the separately controlled host conversation boundary."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "current_turn"
              }
            },
            "required": [
              "sourceKind"
            ]
          },
          "then": {
            "properties": {
              "confirmationState": {
                "const": "explicit"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "user_confirmed_context"
              }
            },
            "required": [
              "sourceKind"
            ]
          },
          "then": {
            "properties": {
              "confirmationState": {
                "const": "confirmed"
              }
            }
          }
        }
      ]
    },
    "contextFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "statement",
        "state",
        "sourceRefs"
