          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "confirmationNeeded": {
          "type": "boolean"
        }
      }
    },
    "adaptationFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factorId",
        "label",
        "state",
        "applicability",
        "summary",
        "evidenceRefs"
      ],
      "properties": {
        "factorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "semantic": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_:-]{0,99}$",
          "description": "Optional stable semantic class used to derive invalidation behavior for a custom factor id. Absence falls back to factorId."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "state": {
          "enum": [
            "observed",
            "user_stated",
            "inferred",
            "unknown"
          ]
        },
        "applicability": {
          "enum": [
            "applicable",
            "not_applicable",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
