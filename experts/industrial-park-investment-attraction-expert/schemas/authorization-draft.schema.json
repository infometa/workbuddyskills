{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workbuddy.local/industrial-park-investment-attraction-expert/authorization-draft.schema.json",
  "title": "AuthorizationDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actionType",
    "targetRefs",
    "contentHash",
    "requiredApprovals",
    "expiresAt",
    "state",
    "executed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "actionType": {
      "anyOf": [
        {
          "enum": [
            "send_email",
            "send_im",
            "crm_upsert",
            "schedule_meeting"
          ]
        },
        {
          "type": "string",
          "pattern": "^custom:[a-z0-9][a-z0-9_-]{1,63}$"
        }
      ]
    },
    "targetRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requiredApprovals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "const": "draft_only"
    },
    "executed": {
      "const": false
    }
  }
}
