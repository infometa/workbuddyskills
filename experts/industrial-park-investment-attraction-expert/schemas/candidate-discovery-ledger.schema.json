{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workbuddy.local/industrial-park-investment-attraction-expert/candidate-discovery-ledger.schema.json",
  "title": "CandidateDiscoveryLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ledgerId",
    "revision",
    "previousRevisionRef",
    "asOf",
    "parkBriefRef",
    "queryLedger",
    "candidates",
    "truthBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "ledgerId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previousRevisionRef": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "parkBriefRef": {
      "type": "string",
      "minLength": 1
    },
    "queryLedger": {
      "$ref": "query-ledger.schema.json"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "discoveryId",
          "displayName",
          "entityHint",
          "possibleLegalNames",
          "officialDomainHints",
          "discoveryReason",
          "targetRoleHints",
          "matchedSignals",
          "queryRefs",
          "sourceRefs",
          "publicEntryHints",
          "entityResolutionState",
          "state"
        ],
        "properties": {
          "discoveryId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "entityHint": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "possibleLegalNames": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 300
            }
          },
          "officialDomainHints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 253
            }
          },
          "discoveryReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "targetRoleHints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "matchedSignals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "queryRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "publicEntryHints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://(?!(?:localhost|127(?:\\.[0-9]{1,3}){3}|10(?:\\.[0-9]{1,3}){3}|192\\.168(?:\\.[0-9]{1,3}){2}|172\\.(?:1[6-9]|2[0-9]|3[01])(?:\\.[0-9]{1,3}){2}|169\\.254(?:\\.[0-9]{1,3}){2}|0\\.0\\.0\\.0|\\[::1\\])(?::[0-9]+)?(?:/|$))"
            }
          },
          "entityResolutionState": {
            "const": "unresolved",
            "description": "Discovery is not allowed to resolve, merge, reject, or qualify an entity. EntityRecord is the sole resolution authority."
          },
          "state": {
            "const": "discovered_not_qualified"
          }
        }
      }
    },
    "truthBoundary": {
      "const": "discovery_is_not_entity_resolution_fit_or_intent"
    }
  }
}
